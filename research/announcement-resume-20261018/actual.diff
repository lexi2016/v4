+                                       "prompt_sha256": plan["prompt_sha256"],
+                                       "configuration_sha256": plan["configuration_sha256"],
+                                       "source_unit_map_sha256": plan["source_unit_map_sha256"],
+                                       "fixed_fact_ledger_sha256": plan["fixed_fact_ledger_sha256"],
