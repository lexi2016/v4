+def _manager_original_fields(source: Mapping[str, Any], row: Mapping[str, Any], source_sha: str) -> dict | None:
+    """Recover optional fields from exact raw source rows, not names or clocks.
+
+    The existing lane retains raw_items/raw_payload. Its timeline intentionally
+    projects fewer fields. All source locators, explicit code and source prose
+    must agree; conflicting candidates do not lend each other clocks or tickers.
+    """
+    matches = []
+    for raw in source.get("raw_items", []):
+        if not isinstance(raw, Mapping) or not isinstance(raw.get("raw_payload"), Mapping):
+            continue
+        original = raw["raw_payload"]
+        if (raw.get("raw_id") != original.get("raw_id") or not raw.get("raw_id")
+                or str(original.get("stock_code", "")) != str(row.get("stock_code", ""))
+                or any(raw.get(a) != row.get(b) for a, b in (
+                    ("source_type", "source_type"), ("source_name", "source_name"),
+                    ("source_path", "source_path"), ("url", "url"), ("title", "source_title")))
+                or not row.get("evidence_sentence")
+                or str(row["evidence_sentence"]) not in str(raw.get("raw_text", ""))):
+            continue
+        fields = {k: deepcopy(original[k]) for k in MANAGER_SOURCE_FIELDS if k in original}
+        matches.append((raw["raw_id"], fields))
+    if not matches or not matches[0][1] or any(fields != matches[0][1] for _, fields in matches):
+        return None
+    return {"source_input_sha256": source_sha.lower(),
+            "raw_ids": sorted({key for key, _ in matches}), "fields": matches[0][1]}
 
 
