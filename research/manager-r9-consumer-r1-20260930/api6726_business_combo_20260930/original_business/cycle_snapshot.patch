+def run_announcement_then_preopen_cycle(service: Any, source_date: str, *, schedule: Mapping[str, Any],
+                                         preopen_config: Mapping[str, Any] | None = None,
+                                         announcement_enabled: bool = True, clock=None) -> dict:
+    """One collection, then original pre-open owner with a fresh completion clock.
+
+    Collection errors do not hide previously committed inputs. Cancellation or
+    the worker's hard deadline still propagates. The original autorun alone
+    decides NOT_DUE/EXPIRED and owns transaction-level input idempotency.
+    """
+    from v4.manager_research.workspace_projection import HK
+    from v4.manager_research.workspace_plan_autorun import run_scheduled_preopen_plan_safe
+    if announcement_enabled:
+        try:
+            collected=service.refresh_announcements(source_date,schedule=dict(schedule))
+        except Exception as exc:
+            # Do not serialize arbitrary provider exception text or credentials.
+            collected={'status':'FAILED','reason':type(exc).__name__}
+    else:
+        collected={'status':'ANNOUNCEMENT_COLLECTION_DISABLED'}
+    observed=clock() if clock is not None else datetime.now(HK)
+    plan=run_scheduled_preopen_plan_safe(service,source_date,now=observed,config=preopen_config)
+    return dict(status=collected['status'],attempt=(collected.get('attempt') or {}).get('run_id'),
+        announcement_failure=collected.get('reason'),preopen_plan=plan,
+        production_allowed=False,buy_gate_updated=False,orders_sent=False)
 
 
