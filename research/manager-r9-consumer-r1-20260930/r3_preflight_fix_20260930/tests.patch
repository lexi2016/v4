+def test_receipt_is_create_only(tmp_path, trees):
+    _, _, output = run_tool(tmp_path, trees)
+    before = output.read_bytes()
+    proc, _, _ = run_tool(tmp_path, trees)
+    assert proc.returncode == 2 and output.read_bytes() == before
