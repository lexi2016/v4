+        except (OSError, ValueError, SyntaxError, UnicodeError):
+            records[rel] = {'sha256': None, 'status': 'UNREADABLE_OR_INVALID'}
+            alerts.append({'code': 'SOURCE_UNREADABLE_OR_INVALID', 'path': rel})
