+def git_identity(root, paths):
+    """Read only; fsmonitor and optional index writes disabled; never emit diffs."""
+    command = ['/usr/bin/git', '--no-optional-locks', '-c', 'core.fsmonitor=false', '-C', str(root)]
+    try:
+        env = {'PATH': '/usr/bin:/bin', 'HOME': str(Path.home()), 'GIT_OPTIONAL_LOCKS': '0',
+               'GIT_CONFIG_NOSYSTEM': '1', 'GIT_CONFIG_GLOBAL': '/dev/null', 'GIT_TERMINAL_PROMPT': '0'}
+        head = subprocess.run(command + ['rev-parse', '--verify', 'HEAD'], env=env,
+                              capture_output=True, timeout=5, check=True).stdout.decode().strip()
+        if not re.fullmatch('[0-9a-f]{40,64}', head):
+            raise EvidenceError('GIT_HEAD_INVALID')
+        raw = subprocess.run(command + ['status', '--porcelain=v1', '-z', '--untracked-files=all',
+                                       '--', *sorted(paths)], env=env, capture_output=True, timeout=5, check=True).stdout
+        if len(raw) > 1024 * 1024:
+            raise EvidenceError('GIT_OUTPUT_BUDGET')
+        entries = raw.decode('utf-8').split('\0')
+        changes = {e[3:]: e[:2] for e in entries if len(e) >= 4 and e[3:] in paths}
+        return {'status': 'READ_ONLY_SCOPED_STATUS', 'head': head, 'changes': changes,
+                'status_bytes_sha256': sha(raw), 'scope_only': True}
+    except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
+        return {'status': 'CANNOT_CONFIRM', 'changes': {}, 'scope_only': True}
+
