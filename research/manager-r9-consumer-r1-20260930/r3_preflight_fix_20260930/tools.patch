+def closure(root):
+    """Conservative static import over-approximation, NOT a runtime closure proof."""
+    pending = list(REQUIRED)
+    records, alerts, external, edges, stats = {}, [], set(), [], {}
+    total = 0
+
+    def present(rel):
+        return (root / rel).exists() or (root / rel).is_symlink()
+
+    def module(name, source, line, required=True):
+        if not name or name.split('.')[0] not in LOCAL:
+            external.add(name.split('.')[0] if name else '<relative>')
+            return
+        base = name.replace('.', '/')
+        candidates = [base + '.py', base + '/__init__.py']
+        found = [p for p in candidates if present(p)]
+        if not found and not (root / base).is_dir() and required:
+            alerts.append({'code': 'LOCAL_IMPORT_MISSING', 'path': source, 'line': line, 'module': name})
+        for rel in found:
+            pending.append(rel)
+            edges.append({'source': source, 'line': line, 'target': rel})
+        parts = base.split('/')
+        for n in range(1, len(parts)):
+            rel = '/'.join(parts[:n]) + '/__init__.py'
+            if present(rel):
+                pending.append(rel)
+
+    for rel in OPTIONAL:
+        if present(rel):
+            pending.append(rel)
+    # Include both known split families and namespace helpers, even with indirect dispatch.
+    for rel in SPLIT:
+        if not (root / rel).exists() and not (root / rel).is_symlink():
+            continue
+        try:
+            names = []
+            with parent_fd(root / rel / '__not_opened__') as (fd, _):
+                with os.scandir(fd) as entries:
+                    for entry in entries:
+                        names.append(entry.name)
+                        if len(names) > MAX_DIR:
+                            raise EvidenceError('SPLIT_DIRECTORY_BUDGET_EXCEEDED')
+            pending.extend(rel + '/' + n for n in sorted(names) if n.endswith('.py'))
+        except (OSError, EvidenceError):
+            alerts.append({'code': 'SPLIT_DIRECTORY_UNREADABLE_OR_OVER_BUDGET', 'path': rel})
+    while pending:
+        rel = pending.pop(0)
+        if rel in records:
+            continue
+        if len(records) >= MAX_FILES:
+            alerts.append({'code': 'FILE_COUNT_BUDGET_EXCEEDED'})
+            break
+        try:
+            raw, sig = read_bytes(root / rel)
+            total += len(raw)
+            if total > MAX_TOTAL:
+                raise EvidenceError('TOTAL_BYTE_BUDGET_EXCEEDED')
+            records[rel] = {'sha256': sha(raw), 'bytes': len(raw), 'status': 'READ'}
+            stats[rel] = sig
+            if not rel.endswith('.py'):
+                continue
+            tree = ast.parse(raw, filename=rel)
+            package = rel[:-3].split('/')[:-1]
+            if rel.endswith('/__init__.py'):
+                package = rel.split('/')[:-1]
+            for node in ast.walk(tree):
+                if isinstance(node, ast.Import):
+                    for alias in node.names:
+                        module(alias.name, rel, node.lineno)
+                elif isinstance(node, ast.ImportFrom):
+                    prefix = package[:len(package) - node.level + 1] if node.level else []
+                    if node.level > len(package) + 1:
+                        raise EvidenceError('RELATIVE_IMPORT_OUTSIDE_ROOT')
+                    base = '.'.join([*prefix, *([node.module] if node.module else [])])
+                    module(base, rel, node.lineno)
+                    for alias in node.names:
+                        if alias.name != '*':
+                            module(base + '.' + alias.name, rel, node.lineno, required=False)
+                        else:
+                            alerts.append({'code': 'STAR_IMPORT_REQUIRES_REVIEW', 'path': rel, 'line': node.lineno})
+                elif isinstance(node, ast.Call):
