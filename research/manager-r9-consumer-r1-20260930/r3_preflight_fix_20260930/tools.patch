+def audit(canonical, plist_path):
+    result = {'schema_version': 'v4.issue8.r3.preflight_evidence.v2', 'status': 'CANNOT_CONFIRM',
+              'source_mapping_status': 'CANNOT_CONFIRM', 'historical_lineage': 'CANNOT_CONFIRM',
+              'behavior_equivalence': 'CANNOT_CONFIRM', 'formal_activation': 'CANNOT_CONFIRM',
+              'producer_edit_allowed': False, 'files': [], 'gaps': [],
+              'audit_started_at': datetime.now(timezone.utc).isoformat(),
+              'network_requests': 0, 'business_writes': 0, 'RESEARCH_ONLY': True,
+              'production_allowed': False, 'buy_gate_updated': False, 'orders_sent': False}
+    try:
+        raw, _ = read_bytes(plist_path)
+        result['plist_identity'] = {'sha256': sha(raw), 'bytes': len(raw), 'raw_or_env_exported': False}
+        release = resolve_release(plistlib.loads(raw))
+        result['configured_release_root'] = str(release)
+        result['canonical_root'] = str(canonical)
+        result['root_resolution'] = 'UNAMBIGUOUS_PLIST_PATHS'
+        left, right = closure(canonical), closure(release)
+        result['closures'] = {'canonical': left, 'release': right}
+        for rel in sorted(set(left['records']) | set(right['records'])):
+            a, b = left['records'].get(rel, {}), right['records'].get(rel, {})
+            result['files'].append({'path': rel, 'canonical_sha256': a.get('sha256'),
+                                    'release_sha256': b.get('sha256'),
+                                    'byte_equal': bool(a.get('sha256') and a.get('sha256') == b.get('sha256'))})
+        result['file_equality'] = ('EQUAL_FOR_COLLECTED_FILES' if result['files'] and
+                                  all(x['byte_equal'] for x in result['files']) else 'DIFFERENT_OR_MISSING')
+        result['canonical_git'] = git_identity(canonical, left['records'])
+        for row in result['files']:
+            row['canonical_git_status'] = result['canonical_git']['changes'].get(row['path'])
+        try:
+            raw, _ = read_bytes(release.parent / 'release-manifest.json')
+            manifest = json.loads(raw, object_pairs_hook=unique)
+            if not isinstance(manifest, dict):
+                raise EvidenceError('MANIFEST_NOT_OBJECT')
+            declared = {k: manifest.get(k) if manifest.get(k) in STATUS_VALUES else 'UNRECOGNIZED_OR_MISSING'
+                        for k in ('candidate_status', 'activation_status', 'deployment_status')}
+            result['manifest_observation'] = {'sha256': sha(raw), 'bytes': len(raw), 'declared': declared,
+                                               'status_is_assertion_not_proof': True, 'raw_exported': False}
+        except (OSError, ValueError, TypeError, UnicodeError):
+            result['gaps'].append('RELEASE_MANIFEST_UNREADABLE_OR_INVALID')
+        result['gaps'].extend(['EXECUTION_CLOSURE_NOT_RUNTIME_VERIFIED',
+                               'HISTORICAL_BUILD_MAPPING_NOT_PROVEN', 'FORMAL_ACTIVATION_NOT_PROVEN'])
+        result['comparison_completed'] = True
+    except EvidenceError as exc:
+        result['comparison_completed'] = False
+        result['gaps'].append(str(exc))
+    except (OSError, ValueError, TypeError, plistlib.InvalidFileException):
+        # Deliberately never serialize exception text, plist arguments, or environment values.
+        result['comparison_completed'] = False
+        result['gaps'].append('INPUT_OR_ROOT_INVALID')
+    result['audit_finished_at'] = datetime.now(timezone.utc).isoformat()
+    return result
