+def _extension_payload(payload, material, extension, extension_sha, count_tokens, cap):
+    from v4.manager_workbench.announcement_preprocessing import SEMANTIC_CONTRACT, SEMANTIC_CONTRACT_VERSION
+    p=copy.deepcopy(payload)
+    if SEMANTIC_CONTRACT not in p['messages'][0]['content']:p['messages'][0]['content']+='\n\n'+SEMANTIC_CONTRACT
+    p['prompt_sha256']=sha(p['messages'][0]['content'].encode())
+    p['configuration_sha256']=material['configuration_sha256']
+    p['semantic_contract_version']=SEMANTIC_CONTRACT_VERSION
+    p['rules']+=f'+semantic-contract:{SEMANTIC_CONTRACT_VERSION}+execution-extension:{extension_sha}'
+    p['execution_extension_sha256']=extension_sha
+    if p['article_id']==extension['failed']['article_id']:
+        p['recovery_of']=copy.deepcopy(extension['failed'])
+        if extension.get('semantic_repair'):p['semantic_recovery_of']=copy.deepcopy(extension['semantic_repair'])
+    p['prompt_tokens_exact']=count_tokens(p['messages'])
+    if p['prompt_tokens_exact']>cap:raise FlashRunError('EXTENSION_PROMPT_TOKEN_CAP_EXCEEDED')
+    return p
+
