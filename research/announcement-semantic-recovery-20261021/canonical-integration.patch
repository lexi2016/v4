+describe("semantic recovery of the frozen announcement job", () => {
+  afterEach(() => { cleanup(); vi.unstubAllGlobals(); vi.restoreAllMocks(); });
+  function value(phase = "RECOVER_FAILED") {
+    const job = "a".repeat(32), report = "b".repeat(64), delivery = "c".repeat(64);
+    return { ...announcementResult([], "d".repeat(64)),
+      job: { job_id: job, target_date: "20261021", state: "PARTIAL", step: "DONE" },
+      preprocessing: { job_id: job, target_date: "20261021", accounting_closed: true,
+        counts: { model_required_articles: 215, primary_dispositions: {} }, rules_explanation: [],
+        first_article_id: "FIRST", execution_manifest: [{ article_id: "FIRST", body_sha256: "e".repeat(64) }] },
+      preprocessing_binding: { sha256: report },
+      daily_delivery: { job_id: job, target_trade_date: "20261021", preprocessing_report_sha256: report,
+        state: "PARTIAL", counts: { FAILED: 1, DEFERRED: 214 }, articles: [
+          { article_id: "FIRST", body_sha256: "e".repeat(64), state: phase === "RECOVER_FAILED" ? "FAILED" : "SUCCEEDED" }],
+        model_progress: { total: 215, counts: { SUCCEEDED: 1, FAILED: 0, DEFERRED: 214 }, current_article_id: "NEXT" } },
+      daily_delivery_binding: { job_id: job, sha256: delivery },
+      semantic_recovery: { eligible: true, status: "READY", job_id: job, target_date: "20261021",
+        report_sha256: report, delivery_sha256: delivery, extension_sha256: "f".repeat(64), phase,
+        total_articles: 215, remaining_articles: 214 } };
+  }
+  it.each(["RECOVER_FAILED", "CONTINUE_REMAINING"])("binds %s to the current job/report/extension and delivery", async phase => {
+    const data = value(phase); const posts: unknown[] = [];
+    vi.stubGlobal("fetch", vi.fn(async (_input: RequestInfo | URL, init: RequestInit = {}) => {
+      if (init.method === "POST") { posts.push(JSON.parse(String(init.body))); return response(envelope({ job_id: data.job.job_id }), 202); }
+      return response(envelope(data));
+    }));
+    render(AnnouncementCandidates, { props: { targetDate: "20261021" } });
+    const button = await screen.findByRole("button", { name: phase === "RECOVER_FAILED" ? "恢复失败公告" : "继续分析剩余公告" });
+    expect(posts).toHaveLength(0);
+    expect(screen.queryByRole("button", { name: "运行首篇新增公告" })).toBeNull();
+    expect(screen.getByText(/本批 215 篇/)).toBeTruthy();
+    expect(screen.getByText(/当前 NEXT/)).toBeTruthy();
+    await fireEvent.click(button);
+    await waitFor(() => expect(posts).toHaveLength(1));
+    expect(posts[0]).toEqual({ phase, report_sha256: data.preprocessing_binding.sha256,
+      first_delivery_sha256: data.daily_delivery_binding.sha256, extension_sha256: data.semantic_recovery.extension_sha256 });
+  });
+  it.each(["job_id", "target_date", "report_sha256", "delivery_sha256", "extension_sha256"])("fails closed on a mismatched %s", async field => {
+    const data = value(); (data.semantic_recovery as Record<string, unknown>)[field] = "";
+    vi.stubGlobal("fetch", vi.fn(async () => response(envelope(data))));
+    render(AnnouncementCandidates, { props: { targetDate: "20261021" } });
+    await screen.findByText("逐篇完整结果与未完成清单");
+    expect(screen.queryByRole("button", { name: "恢复失败公告" })).toBeNull();
+    expect(screen.queryByRole("button", { name: "继续分析剩余公告" })).toBeNull();
+  });
+});
