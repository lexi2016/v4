+def build_shared_hk_0_2_pool(
+    shared_data_root: Path,
+    *,
+    trade_date: str,
+    signal_date: str,
+    eligibility_source_date: str | None = None,
+    eligibility_universe_root: Path | None = None,
+    shared_package_root: Path | None = None,
+    reader=None,
+) -> dict[str, Any]:
+    """Map the verified shared HK 0.2 Top100 into the V3.5 pool contract."""
+    from contracts.trading_calendar import load_market_calendar, previous_session
+    calendar = load_market_calendar()
+    expected_price = previous_session(calendar, trade_date, market="hk_securities")
+    expected_eligibility = previous_session(calendar, trade_date, market="hk_connect")
+    if signal_date != expected_price:
+        raise ValueError("shared HK 0.2 stale price signal; not a formal Stage input")
+    eligibility_source_date = eligibility_source_date or expected_eligibility
+    if eligibility_source_date != expected_eligibility:
+        raise ValueError("shared HK 0.2 eligibility as-of is not the last Connect session")
+    if reader is None:
+        if shared_package_root is None:
+            raise ValueError("shared_package_root is required for HK 0.2 verification")
+        reader = _shared_hk_0_2_reader(shared_package_root)
+    reader_args = {
+        "target_date": trade_date,
+        "expected_signal_date": signal_date,
+    }
+    reader_args["expected_eligibility_source_date"] = eligibility_source_date
+    if eligibility_universe_root is not None:
+        reader_args["eligibility_universe_root"] = eligibility_universe_root
+    pool = reader(Path(shared_data_root), **reader_args)
+    verification = pool.run.verification
+    receipt = pool.run.receipt
+    for key in ("production_allowed", "buy_gate_updated", "orders_sent"):
+        if receipt.get(key) is not False:
+            raise ValueError(f"shared HK 0.2 safety flag {key} must be false")
+    rows: list[dict[str, Any]] = []
+    previous_score: float | None = None
+    for index, raw_value in enumerate(pool.rows, start=1):
+        raw = dict(raw_value)
+        code = str(raw.get("code_norm") or raw.get("code") or "").strip().upper().removeprefix("HK.")
+        rank = _row_number(raw.get("rank"), index)
+        score = _row_float(raw.get("score_prob_active"))
+        if not re.fullmatch(r"\d{5}", code) or rank != index:
+            raise ValueError("shared HK 0.2 identity/rank mismatch")
+        if previous_score is not None and score > previous_score:
+            raise ValueError("shared HK 0.2 score order mismatch")
+        if str(raw.get("signal_date") or "") != signal_date or str(raw.get("target_date") or "") != trade_date:
+            raise ValueError("shared HK 0.2 row date mismatch")
+        if str(raw.get("d1_freshness_status") or "") != "PASS" or str(raw.get("selected_strategy") or "") != "prob_active":
+            raise ValueError("shared HK 0.2 semantic contract mismatch")
+        rows.append({
+            **raw,
+            "symbol": f"HK.{code}",
+            "market": "HK",
+            "pool_id": "hkconnect_d1_top100",
+            "pool_rank": rank,
+            "stock_name": str(raw.get("name") or f"HK.{code}"),
+            "pool_score": score,
+            "recommendation_status": "WATCH_ONLY",
+            "production_allowed": False,
+            "buy_gate_updated": False,
+            "orders_sent": False,
+        })
+        previous_score = score
+    if len(rows) != 100 or len({row["symbol"] for row in rows}) != 100:
+        raise ValueError("shared HK 0.2 Top100 count mismatch")
+    artifact = _artifact(
+        trade_date=trade_date,
+        pool_id="hkconnect_d1_top100",
+        display_name="港股通 0.2 D-1 Top100",
+        market="HK",
+        status="STRICT_0_2_READY",
+        producer_id="v3_shared_hk_0_2_consumer_v1",
+        source_role="SHARED_VERIFIED_HK_0_2",
+        source_path=str(verification["artifact_relative"]),
+        source_sha256=str(verification["artifact_sha256"]),
+        rows=rows,
+        cannot_confirm=["RESEARCH_ONLY_NOT_BUY_GATE"],
+    )
+    artifact["source_run_id"] = str(verification["run_id"])
+    artifact["source_row_count"] = int(verification["row_count"])
+    source_manifest_sha256 = str(
+        verification.get("manifest_sha256") or ""
+    )
+    source_receipt_sha256 = str(
+        verification.get("receipt_sha256") or ""
+    )
+    if source_manifest_sha256:
+        artifact["source_manifest_sha256"] = source_manifest_sha256
+    if source_receipt_sha256:
+        artifact["source_receipt_sha256"] = source_receipt_sha256
+    artifact["signal_date"] = signal_date
+    artifact["target_date"] = trade_date
+    artifact["stage_selection_eligible"] = True
+    source_provenance = dict(pool.run.manifest.get("provenance") or {})
+    try:
+        qualification = json.loads(
+            bytes.fromhex(source_provenance["eligibility_asof_hex"]).decode("utf-8")
+        )
+    except (ValueError, KeyError, TypeError, UnicodeError) as error:
+        raise ValueError("shared HK 0.2 eligibility as-of is invalid") from error
+    if (
+        qualification.get("schema_version") != "v4.hk_eligibility_asof.v1"
+        or qualification.get("source_date") != eligibility_source_date
+        or qualification.get("validity")
+        not in {"EXACT_CAPTURE_DATE_ONLY", "OFFICIAL_EFFECTIVE_RECOVERY"}
+        or qualification.get("natural_verified") is not False
+        or any(qualification.get(flag) is not False for flag in
+               ("production_allowed", "buy_gate_updated", "orders_sent"))
+    ):
+        raise ValueError("shared HK 0.2 eligibility as-of/date mismatch")
+    historical_provenance = {
+        "schema_version": "v4.hk_d1_eligibility_asof.v2",
+        "price_signal_date": signal_date,
+        "eligibility_source_date": eligibility_source_date,
+        "eligibility_asof": qualification,
+        "d1_source_run_id": artifact["source_run_id"],
+        "d1_source_artifact_sha256": artifact["source_sha256"],
+        "d1_source_manifest_sha256": source_manifest_sha256,
+        "d1_source_receipt_sha256": source_receipt_sha256,
+    }
+    price_history_hex = source_provenance.get("price_history_recovery_hex")
+    if price_history_hex:
+        try:
+            price_history = json.loads(bytes.fromhex(price_history_hex).decode("utf-8"))
+        except (ValueError, TypeError, UnicodeError, json.JSONDecodeError) as error:
+            raise ValueError("shared HK 0.2 price history provenance is invalid") from error
+        if (
+            price_history.get("schema_version") != "v4.hk_history_price_recovery.v1"
+            or price_history.get("source_date") != signal_date
+            or price_history.get("provider") != "FUTU_OPEND_HISTORY_KLINE"
+            or price_history.get("adjustment") != "NONE"
+            or price_history.get("natural_verified") is not False
+        ):
+            raise ValueError("shared HK 0.2 price history provenance mismatch")
+        historical_provenance["price_recovery"] = price_history
+    artifact["historical_provenance"] = historical_provenance
+    return artifact
+
