-                            raise ValueError(
-                                "HK authority chain conflict: exclusive create lost"
-                            ) from error
-                        if existing != encoded:
-                            raise ValueError(
-                                "HK authority chain conflict: partial or differing authority"
-                            )
-                chain["write_performed"] = True
