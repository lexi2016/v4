+                    raise RuntimeError(
+                        f"FUTU_GET_PLATE_STOCK_FAILED:{plate_code}:{frame}"
+                    )
+                codes: list[str] = []
+                for row in _plate_rows(frame, plate_code):
+                    raw_code = row.get("code")
+                    code = raw_code.strip().upper() if isinstance(raw_code, str) else ""
+                    if not _HK_CODE_RE.fullmatch(code):
