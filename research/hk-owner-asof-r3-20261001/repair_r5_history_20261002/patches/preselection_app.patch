+def _normalize_name(value: Any) -> str:
+    text = re.sub(r"[\(（]\s*代码待核\s*[\)）]", "", str(value or "").strip())
+    return re.sub(r"\s+", "", text).strip("：:，,。；;#【】[]“”\"' ")
+
