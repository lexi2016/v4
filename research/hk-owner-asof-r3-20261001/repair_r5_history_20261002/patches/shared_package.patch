+        path=artifact_path,
+        trade_date=target,
+        market="HK_CONNECT",
+        scope="FULL_MARKET",
+        codes=codes,
+        codes_sha256=str(codes_sha256),
+        source_role=HK_CONNECT_SOURCE_ROLE,
+        source_sha256=str(source_sha256),
+        schema_version=UNIVERSE_SCHEMA_VERSION_V1,
+        stage_selection_eligible=True,
+    )
