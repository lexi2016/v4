+def _vipdoc_lday_root(tdx_root: Path) -> Path:
+    candidates = (tdx_root / "vipdoc" / "ds" / "lday", tdx_root)
+    for candidate in candidates:
+        if candidate.is_dir() and any(candidate.glob("71#*.day")):
+            return candidate
+    raise StoreError("HK 0.2 VIPDOC lday source is missing")
+
+
+def _read_vipdoc_increment(
+    lday_root: Path,
+    *,
+    after_date: str,
+    through_date: str,
+    evidence: dict[str, Any] | None = None,
+) -> tuple[list[dict[str, Any]], int]:
+    # This describes bytes observed by THIS read, not historic availability or
+    # vendor units. The inherited/seed panel is explicitly outside its scope.
+    started_at = datetime.now(timezone.utc).isoformat()
+    source_files: list[dict[str, Any]] = []
+    rows: list[dict[str, Any]] = []
+    files = sorted(lday_root.glob("71#*.day"))
+    for path in files:
+        code = _normalize_code(path.stem)
+        raw_code = code.replace("HK.", "")
+        if not code:
+            continue
+        if evidence is not None and path.is_symlink():
+            raise StoreError("HK02_NATIVE_SOURCE_SYMLINK")
+        before = path.stat()
+        size = before.st_size
+        file_hash = hashlib.sha256()
+        first_row = len(rows)
+        if size % _VIPDOC_DAY_STRUCT.size:
+            raise StoreError(f"HK 0.2 VIPDOC file has trailing bytes: {path.name}")
+        with path.open("rb") as handle:
+            while raw := handle.read(_VIPDOC_DAY_STRUCT.size):
+                file_hash.update(raw)
+                date_int, open_v, high_v, low_v, close_v, amount_v, trade_v, position_v = _VIPDOC_DAY_STRUCT.unpack(raw)
+                date_text = _compact_date(date_int)
+                if not date_text or date_text <= after_date or date_text > through_date:
+                    continue
+                if (
+                    min(open_v, high_v, low_v, close_v) <= 0
+                    or high_v < low_v
+                    or close_v > high_v
+                    or close_v < low_v
+                ):
+                    continue
+                rows.append(
+                    {
+                        "trade_date": int(date_text),
+                        "trade_date_compact": date_text,
+                        "code_norm": code,
+                        "ts_code": f"{raw_code}.HK_CONNECT",
+                        "raw_code": raw_code,
+                        "market_type": "HK",
+                        "exchange": "HK_CONNECT",
+                        "open": float(open_v),
+                        "high": float(high_v),
+                        "low": float(low_v),
+                        "close": float(close_v),
+                        "amount": float(amount_v),
+                        "trade": int(trade_v),
+                        "position": int(position_v),
+                        "source": "tdx_vipdoc_71_day",
+                        "source_path": f"vipdoc/ds/lday/{path.name}",
+                        "name": "",
+                    }
+                )
+        after = path.stat()
+        fingerprint = lambda stat: (stat.st_dev, stat.st_ino, stat.st_size, stat.st_mtime_ns)
+        if evidence is not None and fingerprint(before) != fingerprint(after):
+            raise StoreError("HK02_NATIVE_SOURCE_CHANGED_DURING_READ")
+        if len(rows) > first_row:
+            source_files.append({"source_relative": f"vipdoc/ds/lday/{path.name}",
+                                 "sha256": file_hash.hexdigest(), "size_bytes": size,
+                                 "selected_rows": len(rows) - first_row})
+    if evidence is not None:
+        evidence.clear()
+        evidence.update({
+            "schema_version": "v3_shared_data.hk02_native_observation.v1",
+            "scope": "NEW_INCREMENT_ONLY",
+            "owner_source_sha256": sha256_file(Path(__file__)),
+            "read_started_at": started_at,
+            "read_completed_at": datetime.now(timezone.utc).isoformat(),
+            "requested_after_date": after_date,
+            "requested_through_date": through_date,
+            "selected_dates": sorted({row["trade_date_compact"] for row in rows}),
+            "source_files": source_files,
+            "session_finality": "NOT_ATTESTED_BY_PROVIDER",
+            "fields": {
+                "trade": {"native_field": "trade_v", "byte_offset": 24,
+                          "storage_type": "uint32_le", "scale_applied": 1,
+                          "unit": None, "unit_status": "NOT_PROVEN"},
+                "amount": {"native_field": "amount_v", "byte_offset": 20,
+                           "storage_type": "float32_le", "scale_applied": 1,
+                           "unit": None, "currency": None, "unit_status": "NOT_PROVEN"},
+                "price": {"native_fields": ["open_v", "high_v", "low_v", "close_v"],
+                          "byte_offsets": [4, 8, 12, 16], "storage_type": "float32_le",
+                          "scale_applied": 1, "currency": None,
+                          "currency_status": "NOT_PROVEN", "transform": "NONE"}
+            }
+        })
+    return rows, len(files)
+
+
+def _enrich_vipdoc_increment(existing, increment):
+    import numpy as np
+    import pandas as pd
+
+    if increment.empty:
+        return increment
+    prior_by_code = {
+        str(code): group.sort_values("trade_date_compact").iloc[-1]
+        for code, group in existing.groupby("code_norm", sort=False)
+    }
+    enriched: list[dict[str, Any]] = []
+    for code, group in increment.sort_values(["code_norm", "trade_date_compact"]).groupby("code_norm", sort=True):
+        prior = prior_by_code.get(str(code))
+        for _, item in group.iterrows():
+            row = item.to_dict()
+            break_reason = ""
+            pre_close: float | None = None
+            prior_segment = 0
+            if prior is None:
+                break_reason = "first_observation"
+            else:
+                prior_close = float(prior["close"])
+                prior_date = datetime.strptime(str(prior["trade_date_compact"]), "%Y%m%d")
+                current_date = datetime.strptime(str(row["trade_date_compact"]), "%Y%m%d")
+                prior_segment_value = prior.get("continuity_segment_id", 1)
+                prior_segment = int(prior_segment_value) if pd.notna(prior_segment_value) else 1
+                close_ratio = float(row["close"]) / prior_close if prior_close > 0 else math.inf
+                if (current_date - prior_date).days > _MAX_PRE_CLOSE_GAP_CALENDAR_DAYS:
+                    break_reason = "long_calendar_gap"
+                elif close_ratio > _MAX_CROSS_DAY_CLOSE_RATIO or close_ratio < 1.0 / _MAX_CROSS_DAY_CLOSE_RATIO:
+                    break_reason = "cross_day_close_ratio"
+                else:
+                    pre_close = prior_close
+            row["continuity_break"] = break_reason
+            row["pre_close"] = pre_close
+            row["continuity_segment_id"] = max(prior_segment, 0) + (1 if break_reason else 0)
+            row["pct_chg"] = (float(row["close"]) / pre_close - 1.0) * 100.0 if pre_close else np.nan
+            row["amplitude_pct"] = (float(row["high"]) - float(row["low"])) / pre_close * 100.0 if pre_close else np.nan
+            row["intraday_high_pct"] = (float(row["high"]) / pre_close - 1.0) * 100.0 if pre_close else np.nan
+            enriched.append(row)
+            prior = pd.Series(row)
+    return pd.DataFrame(enriched)
+
+
+
+def _validate_history_recovery_provenance(
+    value: Mapping[str, Any], signal_date: str
+) -> dict[str, Any]:
+    from zoneinfo import ZoneInfo
+
+    if not isinstance(value, Mapping):
+        raise StoreError("HK history recovery provenance missing")
+    payload = dict(value)
+    if (
+        payload.get("schema_version") != "v4.hk_history_price_recovery.v1"
+        or payload.get("source_date") != validate_date(signal_date)
+        or payload.get("provider") != "FUTU_OPEND_HISTORY_KLINE"
+        or payload.get("adjustment") != "NONE"
+        or payload.get("natural_verified") is not False
+        or any(payload.get(key) is not False for key in
+               ("production_allowed", "buy_gate_updated", "orders_sent"))
+    ):
+        raise StoreError("HK history recovery provenance identity invalid")
+    source_sha = str(payload.get("source_sha256") or "")
+    requested_codes_sha = str(payload.get("requested_codes_sha256") or "")
+    if (
+        len(source_sha) != 64
+        or any(ch not in "0123456789abcdef" for ch in source_sha)
+        or len(requested_codes_sha) != 64
+        or any(ch not in "0123456789abcdef" for ch in requested_codes_sha)
+    ):
+        raise StoreError("HK history recovery source SHA invalid")
+    try:
+        requested = datetime.fromisoformat(str(payload.get("requested_at") or ""))
+        received = datetime.fromisoformat(str(payload.get("received_at") or ""))
+    except ValueError as error:
+        raise StoreError("HK history recovery timestamps invalid") from error
+    if requested.tzinfo is None or received.tzinfo is None or received < requested:
+        raise StoreError("HK history recovery timestamps invalid")
+    if received.astimezone(ZoneInfo("Asia/Shanghai")).strftime("%Y%m%d") < signal_date:
+        raise StoreError("HK history recovery receive time predates source date")
+    for key in ("requested_code_count", "row_count"):
+        raw = payload.get(key)
+        if isinstance(raw, bool) or not isinstance(raw, int) or raw < 0:
+            raise StoreError("HK history recovery row-count evidence invalid")
+    if payload["row_count"] > payload["requested_code_count"]:
+        raise StoreError("HK history recovery row-count evidence invalid")
+    return payload
+
+
+def _recompute_hk_panel_continuity(frame):
+    import numpy as np
+    import pandas as pd
+
+    output = frame.copy()
+    output["trade_date_compact"] = output["trade_date_compact"].astype(str)
+    output["code_norm"] = output["code_norm"].map(_normalize_code)
+    output = output.sort_values(["code_norm", "trade_date_compact"]).reset_index(drop=True)
+    for code, indexes in output.groupby("code_norm", sort=False).groups.items():
+        prior_close = None
+        prior_date = None
+        segment = 0
+        for index in indexes:
+            current_date = datetime.strptime(
+                str(output.at[index, "trade_date_compact"]), "%Y%m%d"
+            )
+            current_close = float(output.at[index, "close"])
+            break_reason = ""
+            pre_close = None
+            if prior_close is None:
+                break_reason = "first_observation"
+            else:
+                gap = (current_date - prior_date).days
+                ratio = current_close / prior_close if prior_close > 0 else math.inf
+                if gap > _MAX_PRE_CLOSE_GAP_CALENDAR_DAYS:
+                    break_reason = "long_calendar_gap"
+                elif (
+                    ratio > _MAX_CROSS_DAY_CLOSE_RATIO
+                    or ratio < 1.0 / _MAX_CROSS_DAY_CLOSE_RATIO
+                ):
+                    break_reason = "cross_day_close_ratio"
+                else:
+                    pre_close = prior_close
+            if break_reason:
+                segment += 1
+            output.at[index, "continuity_break"] = break_reason
+            output.at[index, "continuity_segment_id"] = segment
+            output.at[index, "pre_close"] = pre_close if pre_close is not None else np.nan
+            if pre_close:
+                output.at[index, "pct_chg"] = (current_close / pre_close - 1.0) * 100.0
+                output.at[index, "amplitude_pct"] = (
+                    (float(output.at[index, "high"]) - float(output.at[index, "low"]))
+                    / pre_close * 100.0
+                )
+                output.at[index, "intraday_high_pct"] = (
+                    float(output.at[index, "high"]) / pre_close - 1.0
+                ) * 100.0
+            else:
+                output.at[index, "pct_chg"] = np.nan
+                output.at[index, "amplitude_pct"] = np.nan
+                output.at[index, "intraday_high_pct"] = np.nan
+            prior_close = current_close
+            prior_date = current_date
+    return output
+
+
+def backfill_hk_0_2_panel_from_history(
+    asset_root: Path | str,
+    *,
+    signal_date: str,
+    rows: Iterable[Mapping[str, Any]],
+    history_provenance: Mapping[str, Any],
+    minimum_code_count: int = 500,
+    minimum_positive_coverage_rate: float = 0.80,
+) -> dict[str, Any]:
+    """Fill one missing historical session in the existing shared HK panel.
+
+    The immutable parent remains evidence. The new panel carries the real
+    provider retrieval timestamps; it never fabricates a signal-date capture.
+    """
+    import pandas as pd
+
+    signal_date = validate_date(signal_date)
+    provenance = _validate_history_recovery_provenance(
+        history_provenance, signal_date
+    )
+    asset_root = Path(asset_root)
+    assets = load_frozen_hk_0_2_assets(asset_root)
+    existing = pd.read_parquet(assets.panel_path)
+    if existing.empty or not {
+        "trade_date_compact", "code_norm", "open", "high", "low", "close"
+    }.issubset(existing.columns):
+        raise StoreError("HK 0.2 current panel is invalid")
+    existing["trade_date_compact"] = existing["trade_date_compact"].astype(str)
+    current_max = str(existing["trade_date_compact"].max())
+    if signal_date > current_max:
+        raise StoreError("HK history recovery is not a panel gap")
+    existing_day = existing[existing["trade_date_compact"].eq(signal_date)]
+    if not existing_day.empty:
+        if existing_day["code_norm"].nunique() >= minimum_code_count:
+            raise StoreError("HK history recovery date already materialized")
+        raise StoreError("HK history recovery conflicts with partial existing date")
+
+    raw_rows = [dict(row) for row in rows]
+    if provenance.get("row_count") != len(raw_rows):
+        raise StoreError("HK history recovery row-count provenance mismatch")
+    codes: set[str] = set()
+    increment_rows: list[dict[str, Any]] = []
+    for row in raw_rows:
+        code = _normalize_code(row.get("code"))
+        if (
+            row.get("trade_date") != signal_date
+            or row.get("source") != "FUTU_HISTORY_KLINE_NONE"
+            or not code or code in codes
+        ):
+            raise StoreError("HK history recovery row identity invalid")
+        name = str(row.get("name") or "").strip()
+        if _is_name_code_placeholder(code, name):
+            raise StoreError(f"HK history recovery name missing: {code}")
+        try:
+            open_price = float(row["open"]); high_price = float(row["high"])
+            low_price = float(row["low"]); close_price = float(row["close"])
+            volume = float(row["volume"]); turnover = float(row["turnover"])
+        except (KeyError, TypeError, ValueError) as error:
+            raise StoreError("HK history recovery numeric row invalid") from error
+        if (
+            min(open_price, high_price, low_price, close_price) <= 0
+            or high_price < low_price or close_price < low_price
+            or close_price > high_price or volume < 0 or turnover < 0
+        ):
+            raise StoreError("HK history recovery OHLC/volume invalid")
+        raw_code = code[3:]
+        increment_rows.append({
+            "trade_date": int(signal_date),
+            "trade_date_compact": signal_date,
+            "code_norm": code,
+            "ts_code": f"{raw_code}.HK_CONNECT",
+            "raw_code": raw_code,
+            "market_type": "HK",
+            "exchange": "HK_CONNECT",
+            "open": open_price, "high": high_price, "low": low_price,
+            "close": close_price, "amount": turnover, "trade": int(round(volume)),
+            "position": 0, "source": "futu_opend_history_kline_none",
+            "source_path": "FUTU_OPEND_HISTORY_KLINE", "name": name,
+        })
+        codes.add(code)
+    if len(codes) < minimum_code_count:
+        raise StoreError(
+            f"HK history recovery market coverage below {minimum_code_count}"
+        )
+    positive_trade = sum(float(row["trade"]) > 0 for row in increment_rows) / len(increment_rows)
+    positive_amount = sum(float(row["amount"]) > 0 for row in increment_rows) / len(increment_rows)
+    if min(positive_trade, positive_amount) < minimum_positive_coverage_rate:
+        raise StoreError("HK history recovery positive coverage below minimum")
+
+    increment = pd.DataFrame(increment_rows)
+    output = pd.concat([existing, increment], ignore_index=True, sort=False)
+    duplicate_mask = output.duplicated(
+        ["trade_date_compact", "code_norm"], keep=False
+    )
+    if bool(duplicate_mask.any()):
+        raise StoreError("HK history recovery duplicate conflict")
+    if signal_date not in set(output["trade_date_compact"].astype(str)):
+        raise StoreError("HK history recovery date missing after merge")
+    output = _recompute_hk_panel_continuity(output)
+
+    staging = asset_root / "panels" / (
+        f".history-{signal_date}-{os.getpid()}.parquet"
+    )
+    staging.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        output.to_parquet(staging, index=False)
+        panel_sha = sha256_file(staging)
+        panel_dir = asset_root / "panels" / (
+            f"{current_max}-history-{signal_date}-{panel_sha[:12]}"
+        )
+        destination = panel_dir / "hkconnect_vipdoc_daily_panel.parquet"
+        if panel_dir.exists():
+            raise StoreError("HK history recovery immutable panel already exists")
+        panel_dir.mkdir(parents=True, exist_ok=False)
+        os.replace(staging, destination)
+    finally:
+        if staging.exists():
+            staging.unlink()
+
+    manifest = {
+        "asset_schema_version": "v3_shared_data.hk_0_2_panel_asset.v2",
+        "source_contract":
+            "tdx_vipdoc_71_day+verified_zero_trade_repairs+futu_history_gapfill",
+        "increment_contract": "futu_opend_request_history_kline_exact_day.v1",
+        "panel_relative":
+            f"panels/{panel_dir.name}/hkconnect_vipdoc_daily_panel.parquet",
+        "panel_sha256": panel_sha,
+        "parent_panel_sha256": str(assets.panel_manifest.get("panel_sha256") or ""),
+        "panel_rows": int(len(output)),
+        "panel_code_count": int(output["code_norm"].nunique()),
+        "panel_max_date": current_max,
+        "new_row_count": len(increment_rows),
+        "new_dates": [signal_date],
+        "through_date_code_count": len(codes),
+        "positive_trade_coverage_rate": positive_trade,
+        "positive_amount_coverage_rate": positive_amount,
+        "source_file_count": 0,
+        "source_location_contract": "FUTU_OPEND_REQUEST_HISTORY_KLINE",
+        "history_recovery": provenance,
+        "manifest_prepared_at": datetime.now(timezone.utc).isoformat(),
+        "research_only": True,
+        "production_allowed": False,
+        "buy_gate_updated": False,
+        "orders_sent": False,
+    }
+    manifest_relative = f"panels/{panel_dir.name}/manifest.json"
+    _write_json(panel_dir / "manifest.json", manifest)
+    _write_json(
+        asset_root / "panel_latest.json",
+        {"manifest_relative": manifest_relative},
+    )
+    return {
+        "status": "READY_HISTORY_GAP_FILLED",
+        "signal_date": signal_date,
+        "panel_max_date": current_max,
+        "through_date_code_count": len(codes),
+        "new_row_count": len(increment_rows),
+        "panel_sha256": panel_sha,
+        "manifest_relative": manifest_relative,
+        "history_recovery": provenance,
+        "production_allowed": False,
+        "buy_gate_updated": False,
+        "orders_sent": False,
+    }
+
