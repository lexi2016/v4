+    )
+    master_capture_date = _capture_date_shanghai(security_master_captured_at)
+    if (
+        eligibility_asof.get("validity") == "EXACT_CAPTURE_DATE_ONLY"
+        and master_capture_date != eligibility_source_date
+    ):
+        raise StoreError("HK 0.2 natural security-master capture date mismatch")
+    if (
+        eligibility_asof.get("validity") == "OFFICIAL_EFFECTIVE_RECOVERY"
