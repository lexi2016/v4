{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:v4:act070a:b-output:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "input_sha256", "claims", "abstain_codes"],
  "properties": {
    "schema_version": {"const": "ACT070A_B_OUTPUT_V1"},
    "case_id": {"$ref": "#/$defs/case_id"},
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "abstain_codes": {"$ref": "#/$defs/gap_codes"}
  },
  "$defs": {
    "case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,47}$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "field"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$"},
        "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$"}
      }
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "gap_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "INSUFFICIENT_D_ONLY_EVIDENCE", "SOURCE_UNBOUND", "COUNTEREVIDENCE_PRESENT",
          "OLD_ANCHOR_UNBOUND", "BREAK_PROOF_UNBOUND", "PIVOT_UNCONFIRMED_AT_D",
          "OPEN_SPAN_AT_D", "NO_COMPUTABLE_TIME_RULE", "UNRESOLVED"
        ]
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "status", "span_refs", "price_refs", "anchor_links", "evidence_refs",
        "counterevidence_refs", "kb_rule_ids", "gap_codes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^C[0-9]{1,4}$"},
        "type": {"enum": ["KEY_K", "PIVOT", "SUPPORT", "OLD_ANCHOR_INVALIDATION", "PHASE"]},
        "status": {"const": "CANDIDATE"},
        "span_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"$ref": "#/$defs/nullable_ref"},
            "end": {"$ref": "#/$defs/nullable_ref"}
          }
        },
        "price_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high"],
          "properties": {
            "low": {"$ref": "#/$defs/nullable_ref"},
            "high": {"$ref": "#/$defs/nullable_ref"}
          }
        },
        "anchor_links": {"$ref": "#/$defs/ref_list"},
        "evidence_refs": {"$ref": "#/$defs/ref_list"},
        "counterevidence_refs": {"$ref": "#/$defs/ref_list"},
        "kb_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["KB_KEY_K", "KB_N_BREATHING", "KB_SUPPORT_BREAK", "KB_WASHOUT_DISTRIBUTION"]}
        },
        "gap_codes": {"$ref": "#/$defs/gap_codes"}
      }
    }
  }
}
