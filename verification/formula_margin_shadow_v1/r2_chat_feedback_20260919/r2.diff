+def _validate_capture_request_static(payload: Mapping[str, Any]) -> dict[str, Any]:
+    """Validate the raw selector capture contract before invoking production.
+
+    This gate deliberately stops before rank, baseline, or tau calculation.
+    It is shared by the capture-specific preflight and the manual capture
+    entrypoint so a preflight PASS means only that the selector may be called.
+    """
+
+    if not isinstance(payload, Mapping):
+        raise ShadowInvalid("capture input must be an object")
+    metadata = _metadata_from_input(payload)
+    if metadata.get("experiment_id", EXPERIMENT_ID) != EXPERIMENT_ID:
+        raise ShadowInvalid("experiment_id mismatch")
+    if metadata.get("observation_mode") not in ("FORWARD_NATURAL", "FORWARD_SHADOW"):
+        raise ShadowInvalid("observation_mode must be FORWARD_NATURAL/FORWARD_SHADOW")
+    _reject_archive_or_proxy_metadata(metadata)
+    trade_date, stage_id, cutoff_iso, cutoff = _stage_contract(metadata)
+    captured_at = _parse_timestamp(metadata.get("captured_at"), trade_date, "captured_at")
+    if captured_at > cutoff:
+        raise ShadowInvalid("captured_at is after the stage cutoff")
+
+    raw_rows = payload.get("rows")
+    if not isinstance(raw_rows, list):
+        raise ShadowInvalid("capture raw rows are required")
+    if len(raw_rows) != POOL_LIMIT:
+        raise ShadowInvalid(f"capture requires exactly {POOL_LIMIT} raw D1 rows; got {len(raw_rows)}")
+    raw_codes: list[str] = []
+    for raw in raw_rows:
+        if not isinstance(raw, Mapping):
+            raise ShadowInvalid("capture raw rows must be objects")
+        raw_codes.append(_canonical_code(raw.get("security_id", raw.get("code"))))
+    if len(set(raw_codes)) != POOL_LIMIT:
+        raise ShadowInvalid("capture raw D1 codes must be unique")
+    raw_code_set = set(raw_codes)
+
+    binding = _source_binding(metadata, require_artifacts=True)
+    source_artifact = _source_artifact_check(
+        metadata,
+        expected_sha=binding["input_sha256"],
+        required=True,
+    )
+    raw_artifact_sha = metadata.get("raw_artifact_sha256")
+    if not _is_sha(raw_artifact_sha) or str(raw_artifact_sha).lower() != str(source_artifact["sha256"]).lower():
+        raise ShadowInvalid("raw_artifact_sha256 is not bound to the verified source artifact")
+    raw_input_sha = sha256_bytes(canonical_json(raw_rows))
+    declared_raw_input_sha = metadata.get("raw_input_sha256")
+    if declared_raw_input_sha not in (None, "") and str(declared_raw_input_sha).lower() != raw_input_sha:
+        raise ShadowInvalid("raw_input_sha256 does not match selector input rows")
+    source_payload = _read_json(Path(str(source_artifact["path"])))
+    if not isinstance(source_payload, Mapping):
+        raise ShadowInvalid("source_artifact must contain an object")
+    source_rows = source_payload.get("rows", source_payload.get("members"))
+    if not isinstance(source_rows, list):
+        raise ShadowInvalid("source_artifact rows are required")
+    if canonical_json(source_rows) != canonical_json(raw_rows):
+        raise ShadowInvalid("source_artifact rows do not canonically match selector raw input")
+
+    d1_manifest = payload.get("d1_manifest", metadata.get("d1_manifest"))
+    d1_binding = _verified_manifest_binding(d1_manifest, "d1_manifest", require_artifact=True)
+    d1_artifact = d1_binding.get("artifact")
+    if not isinstance(d1_artifact, Mapping):
+        raise ShadowInvalid("d1_manifest actual artifact is required")
+    d1_payload = _read_json(Path(str(d1_artifact["path"])))
+    if not isinstance(d1_payload, Mapping):
+        raise ShadowInvalid("d1_manifest artifact must contain an object")
+    d1_rows = d1_payload.get("rows", d1_payload.get("members"))
+    if not isinstance(d1_rows, list) or len(d1_rows) != POOL_LIMIT:
+        raise ShadowInvalid("d1_manifest artifact must contain exactly 100 rows")
+    d1_codes: list[str] = []
+    for row in d1_rows:
+        if not isinstance(row, Mapping):
+            raise ShadowInvalid("d1_manifest artifact rows must be objects")
+        d1_codes.append(_canonical_code(row.get("security_id", row.get("code"))))
+    if len(set(d1_codes)) != POOL_LIMIT or set(d1_codes) != raw_code_set:
+        raise ShadowInvalid("d1_manifest artifact members do not match selector raw input")
+
+    formula_manifest = payload.get("formula_manifest", metadata.get("formula_manifest"))
+    formula_states, formula_binding = _formula_manifest_states(formula_manifest)
+    if len(formula_states) != POOL_LIMIT or set(formula_states) != raw_code_set:
+        raise ShadowInvalid("formula state artifact must cover exactly the 100 selector codes")
+    formula = _formula_provenance(
+        metadata,
+        trade_date,
+        cutoff,
+        require_artifact=True,
+    )
+    if (
+        formula["input_sha256"] != formula_binding["input_sha256"]
+        or formula["rule_sha256"] != formula_binding["rule_sha256"]
+    ):
+        raise ShadowInvalid("formula provenance hashes do not match the verified formula manifest")
+    if formula.get("artifact", {}).get("sha256") != formula_binding.get("artifact", {}).get("sha256"):
+        raise ShadowInvalid("formula provenance state artifact is not the verified manifest artifact")
+    if formula.get("rule_artifact", {}).get("sha256") != formula_binding.get("rule_artifact", {}).get("sha256"):
+        raise ShadowInvalid("formula provenance rule artifact is not the verified manifest rule artifact")
+
+    time_evidence = payload.get("time_evidence", metadata.get("time_evidence"))
+    if not isinstance(time_evidence, Mapping) or not time_evidence:
+        raise ShadowInvalid("verified time_evidence is required for selector capture")
+    evidence_captured = time_evidence.get("captured_at")
+    if not evidence_captured:
+        raise ShadowInvalid("time_evidence.captured_at is required")
+    evidence_at = _parse_timestamp(evidence_captured, trade_date, "time_evidence.captured_at")
+    if evidence_at > cutoff:
+        raise ShadowInvalid("time_evidence.captured_at is after the stage cutoff")
+    if evidence_at != captured_at:
+        raise ShadowInvalid("time_evidence.captured_at does not match metadata captured_at")
+    for key, expected in (("trade_date", trade_date), ("stage", stage_id)):
+        value = time_evidence.get(key)
+        if value not in (None, "") and str(value).replace("-", "") != expected:
+            raise ShadowInvalid(f"time_evidence {key} does not match capture metadata")
+    evidence_cutoff = time_evidence.get("cutoff_ts")
+    if evidence_cutoff not in (None, "") and _parse_timestamp(evidence_cutoff, trade_date, "time_evidence.cutoff_ts") != cutoff:
+        raise ShadowInvalid("time_evidence.cutoff_ts does not match capture metadata")
+
+    return {
+        "trade_date": trade_date,
+        "stage": stage_id,
+        "cutoff_ts": cutoff_iso,
+        "raw_input_sha256": raw_input_sha,
+        "raw_artifact_sha256": str(raw_artifact_sha).lower(),
+        "d1_manifest": d1_binding,
+        "formula_manifest": formula_binding,
+        "production_binding": binding,
+        "time_evidence": dict(time_evidence),
+    }
 
 
