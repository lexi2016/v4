+def preflight_capture_input(payload_or_path: Mapping[str, Any] | Path | str) -> dict[str, Any]:
+    """Run the static admission gate for a raw selector capture request.
+
+    ``READY_FOR_SELECTOR_CAPTURE`` authorizes only the subsequent selector
+    invocation.  It is never a frozen run and never increments a natural-day
+    counter.
+    """
+
+    payload = _read_json(payload_or_path) if isinstance(payload_or_path, (Path, str)) else payload_or_path
+    if not isinstance(payload, Mapping):
+        return {
+            "status": "REJECTED",
+            "capture_ready": False,
+            "reasons": ["INPUT_NOT_OBJECT"],
+            "natural_sample_count": 0,
+            "counts_as_forward_day": False,
+        }
+    try:
+        binding = _validate_capture_request_static(payload)
+    except ShadowInvalid as error:
+        return {
+            "status": "REJECTED",
+            "capture_ready": False,
+            "reasons": [str(error)],
+            "natural_sample_count": 0,
+            "counts_as_forward_day": False,
+            "observation_mode": str(_metadata_from_input(payload).get("observation_mode") or "").upper(),
+        }
+    return {
+        "status": "READY_FOR_SELECTOR_CAPTURE",
+        "capture_ready": True,
+        "reasons": [],
+        "trade_date": binding["trade_date"],
+        "stage": binding["stage"],
+        "cutoff_ts": binding["cutoff_ts"],
+        "raw_input_sha256": binding["raw_input_sha256"],
+        "natural_sample_count": 0,
+        "counts_as_forward_day": False,
+        "frozen": False,
+        **SAFETY_FLAGS,
+    }
+
