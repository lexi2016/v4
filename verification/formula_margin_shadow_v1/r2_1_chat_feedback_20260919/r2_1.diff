+def _validate_capture_time_receipt(
+    receipt: Mapping[str, Any],
+    metadata: Mapping[str, Any],
+    *,
+    require_runtime: bool = False,
+) -> dict[str, Any]:
+    """Validate an immutable capture receipt against its production bindings."""
+
+    if not isinstance(receipt, Mapping):
+        raise ShadowInvalid("capture_time_receipt must be an object")
+    if receipt.get("schema_version") != CAPTURE_TIME_RECEIPT_SCHEMA_VERSION:
+        raise ShadowInvalid("capture_time_receipt schema mismatch")
+    if receipt.get("source") != CAPTURE_TIME_SOURCE:
+        raise ShadowInvalid("capture_time_receipt source mismatch")
+    if receipt.get("experiment_id") != EXPERIMENT_ID:
+        raise ShadowInvalid("capture_time_receipt experiment mismatch")
+    mode = _admission_mode(receipt, default=None)
+    metadata_mode = _admission_mode(metadata, default=None)
+    if mode != metadata_mode:
+        raise ShadowInvalid("capture_time_receipt admission_mode mismatch")
+    trade_date, stage_id, cutoff_iso, _ = _stage_contract(metadata)
+    if str(receipt.get("trade_date") or "").replace("-", "") != trade_date:
+        raise ShadowInvalid("capture_time_receipt trade_date mismatch")
+    if receipt.get("stage") != stage_id or str(receipt.get("cutoff_ts")) != cutoff_iso:
+        raise ShadowInvalid("capture_time_receipt stage/cutoff mismatch")
+    captured_at = _parse_timestamp(receipt.get("captured_at"), trade_date, "capture_time_receipt.captured_at")
+    if require_runtime:
+        _validate_runtime_capture_timestamp(captured_at, trade_date, stage_id)
+    binding = _source_binding(metadata, require_artifacts=True)
+    source_artifact = _source_artifact_check(metadata, expected_sha=binding["input_sha256"], required=True)
+    expected = {
+        "production_run_id": str(metadata.get("run_id") or "").strip(),
+        "raw_artifact_sha256": str(source_artifact["sha256"]).lower(),
+        "production_rule_sha256": binding["rule_sha256"],
+        "shadow_rule_version": RULE_VERSION,
+        "comparator_version": COMPARATOR_VERSION,
+        "selector_invocation": "stage_center.selection.select_hk_four_lane",
+        "selector_invocation_status": "COMPLETED",
+    }
+    for key, expected_value in expected.items():
+        if str(receipt.get(key) or "") != str(expected_value):
+            raise ShadowInvalid(f"capture_time_receipt {key} mismatch")
+    raw_input_sha = metadata.get("raw_input_sha256")
+    if raw_input_sha not in (None, "") and str(receipt.get("raw_input_sha256") or "").lower() != str(raw_input_sha).lower():
+        raise ShadowInvalid("capture_time_receipt raw input SHA mismatch")
+    d1_manifest = _verified_manifest_binding(metadata.get("d1_manifest"), "d1_manifest", require_artifact=True)
+    if str(receipt.get("d1_manifest_sha256") or "").lower() != str(d1_manifest["sha256"]).lower():
+        raise ShadowInvalid("capture_time_receipt D1 manifest SHA mismatch")
+    formula_binding = metadata.get("formula_manifest_binding")
+    if not isinstance(formula_binding, Mapping):
+        raise ShadowInvalid("capture_time_receipt formula binding is missing")
+    formula_state = _checked_file_artifact(
+        formula_binding.get("artifact"),
+        "formula state artifact",
+        expected_sha=str(formula_binding.get("input_sha256") or "").lower(),
+        required=True,
+    )
+    formula_rule = _checked_file_artifact(
+        formula_binding.get("rule_artifact"),
+        "formula rule artifact",
+        expected_sha=str(formula_binding.get("rule_sha256") or "").lower(),
+        required=True,
+    )
+    formula_expected = {
+        "formula_input_sha256": str(formula_binding.get("input_sha256") or "").lower(),
+        "formula_state_artifact_sha256": str(formula_state["sha256"]).lower(),
+        "formula_rule_sha256": str(formula_binding.get("rule_sha256") or "").lower(),
+        "formula_rule_artifact_sha256": str(formula_rule["sha256"]).lower(),
+    }
+    for key, expected_value in formula_expected.items():
+        if str(receipt.get(key) or "").lower() != expected_value:
+            raise ShadowInvalid(f"capture_time_receipt {key} mismatch")
+    for flag, expected_value in SAFETY_FLAGS.items():
+        if receipt.get(flag) != expected_value:
+            raise ShadowInvalid("capture_time_receipt safety flags changed")
+    return dict(receipt)
