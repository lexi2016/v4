+def _capture_time_receipt_payload(
+    metadata: Mapping[str, Any],
+    *,
+    captured_at: datetime,
+    selector_status: str,
+    context: Mapping[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Build the runtime receipt for an actual selector invocation.
+
+    The receipt is made only from already verified artifact bindings.  It does
+    not accept a caller supplied timestamp, source string, or hash as proof of
+    a natural capture.  ``capture_selector_snapshot`` is the only production
+    caller; tests may use the private runtime clock seam.
+    """
+
+    mode = _admission_mode(metadata, default=None)
+    trade_date, stage_id, cutoff_iso, _ = _stage_contract(metadata)
+    runtime_at = _validate_runtime_capture_timestamp(captured_at, trade_date, stage_id)
+    binding = _source_binding(metadata, require_artifacts=True)
