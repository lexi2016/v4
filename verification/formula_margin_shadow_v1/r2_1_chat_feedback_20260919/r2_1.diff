 class ShadowInvalid(ValueError):
     """Raised when a snapshot or label cannot satisfy the frozen contract."""
+
+
+def _admission_mode(value: Mapping[str, Any] | None, *, default: str | None = ENGINEERING_FIXTURE) -> str:
+    """Return the explicit truth/capture admission mode.
+
+    The default is intentionally the engineering mode for the in-memory
+    shadow builder.  A caller that wants a forward or truth admission must
+    state ``REAL_AUTHORITY`` explicitly; that mode is still fail-closed until
+    the existing owner membership and final-close contracts are available.
+    """
+
+    raw = value.get("admission_mode", value.get("truth_admission_mode")) if isinstance(value, Mapping) else None
+    if raw in (None, ""):
+        if default is None:
+            raise ShadowInvalid("admission_mode is required")
+        raw = default
+    mode = str(raw).strip().upper()
+    if mode not in ADMISSION_MODES:
+        raise ShadowInvalid(f"admission_mode must be one of {ADMISSION_MODES}")
+    return mode
+
+
+def _runtime_capture_timestamp() -> datetime:
+    """Return the Shanghai runtime clock used by a real capture.
+
+    This private function is the only test seam.  It is deliberately not a
+    CLI/operator input, so a supplied ``captured_at`` cannot prove a natural
+    observation.
+    """
+
+    return datetime.now(SHANGHAI)
+
+
+def _validate_runtime_capture_timestamp(value: datetime | str, trade_date: str, stage_id: str) -> datetime:
+    """Validate a runtime timestamp against the exact Shanghai stage window."""
+
+    parsed = value if isinstance(value, datetime) else _parse_timestamp(value, trade_date, "runtime captured_at")
+    if parsed.tzinfo is None:
+        parsed = parsed.replace(tzinfo=SHANGHAI)
+    parsed = parsed.astimezone(SHANGHAI)
+    if parsed.strftime("%Y%m%d") != _exact_date(trade_date, "trade_date"):
+        raise ShadowInvalid("runtime capture date does not match trade_date")
+    window = STAGE_CAPTURE_WINDOWS.get(stage_id)
+    if window is None:
+        raise ShadowInvalid(f"stage must be one of {tuple(STAGE_CAPTURE_WINDOWS)}")
+    local_time = parsed.time().replace(tzinfo=None)
+    start = time.fromisoformat(window[0])
+    end = time.fromisoformat(window[1])
+    if local_time < start:
+        raise ShadowInvalid(f"runtime capture is before {stage_id} window")
+    if local_time > end:
+        raise ShadowInvalid(f"runtime capture is after {stage_id} cutoff")
+    return parsed
 
 
