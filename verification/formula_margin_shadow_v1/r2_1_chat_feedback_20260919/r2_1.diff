+        expected_sha=str(formula_binding.get("input_sha256") or "").lower(),
+        required=True,
+    )
+    formula_rule = _checked_file_artifact(
+        formula_binding.get("rule_artifact"),
+        "formula rule artifact",
+        expected_sha=str(formula_binding.get("rule_sha256") or "").lower(),
+        required=True,
+    )
+    raw_artifact_sha = str(metadata.get("raw_artifact_sha256") or source_artifact["sha256"]).lower()
+    if raw_artifact_sha != str(source_artifact["sha256"]).lower():
+        raise ShadowInvalid("capture_time_receipt raw artifact is not source-bound")
+    raw_input_sha = str(metadata.get("raw_input_sha256") or "").lower()
