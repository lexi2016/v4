+    if job.get("status") != "SUCCEEDED":
+        raise FlashRunError("INTERNAL_QUEUE_RESULT_NOT_SUCCEEDED")
+    validated_ref = job.get("validated_path")
+    raw_ref = job.get("raw_path")
