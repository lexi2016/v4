+    })
+    buffer = io.BytesIO()
+    pd.DataFrame(rows).to_parquet(buffer, index=False)
+    raw = buffer.getvalue()
+    digest = _sha(raw)
+    asset = root / "assets/hk_0_2"
+    relative = f"panels/{DAY}-{digest[:12]}/hkconnect_vipdoc_daily_panel.parquet"
+    path = asset / relative
