+def _import_registered_product(service: Any, envelope: Mapping[str, Any]) -> dict[str, Any]:
+    """Use the existing owner for both direct and HTTP registered imports.
+
+    A plain legacy product remains readable but is not given a reviewed owner
+    receipt. Only the existing registered Reader/Reviewer handoff can enter
+    this branch. Retrying a partial write may finish the receipt; retrying a
+    completed import must retain the first actual owner availability time.
+    """
+    from .workspace_announcements import (_now, read_analysis_consumption,
+        validate_agent_judgment_receipt, validate_owner_analysis_import_receipt,
+        validate_registered_handoff)
+
+    if set(envelope) != {"schema_version", "evidence_run_id", "handoff_manifest_sha256", "product_sha256"}:
+        raise ValueError("ANNOUNCEMENT_ANALYSIS_IMPORT_ENVELOPE_INVALID")
+    registered = validate_registered_handoff(service.store, envelope.get("evidence_run_id"),
+        envelope.get("handoff_manifest_sha256"), envelope.get("product_sha256"))
+    product = registered["product"]
+    agent = validate_agent_judgment_receipt(product.get("agent_judgment_receipt"), product)
+    target, publication = product["target_trade_date"], product["publication_date"]
+    owner_path = product_path(service.store, target, publication).with_name("owner_import_receipt.v1.json")
+
+    # Keep the existing lock key, but hold it over read/check/write/readback.
+    # Separate service instances therefore cannot replace the first receipt.
+    with service.store._transaction(target, "announcement-owner-import-receipt"):
+        existing = service.store._read(owner_path)
+        owner_receipt = None
+        if existing is not None:
+            owner_receipt = validate_owner_analysis_import_receipt(existing, product)
+            if (owner_receipt.get("parent_task_id") != agent["parent_task_id"]
+                    or owner_receipt.get("parent_run_id") != agent["parent_run_id"]
+                    or owner_receipt.get("handoff_manifest_sha256", envelope["handoff_manifest_sha256"])
+                    != envelope["handoff_manifest_sha256"]):
+                raise ValueError("ANNOUNCEMENT_ANALYSIS_OWNER_RECEIPT_CONFLICT")
+        imported = import_product(service, product)
+        analysis = imported.get("analysis", {})
+        if analysis.get("status") != "VERIFIED" or analysis.get("product_sha256") != product["sha256"]:
+            raise ValueError("ANNOUNCEMENT_ANALYSIS_IMPORT_READBACK_FAILED")
+        if owner_receipt is None:
+            owner_receipt = dict(
+                schema_version="v4.manager_research.announcement_analysis_owner_import.v1",
+                status="VERIFIED", target_trade_date=target, publication_date=publication,
+                product_sha256=product["sha256"], source_manifest_sha256=product["source_manifest_sha256"],
+                evidence_run_id=agent["evidence_run_id"], handoff_manifest_sha256=envelope["handoff_manifest_sha256"],
+                agent_judgment_receipt_sha256=agent["sha256"], parent_task_id=agent["parent_task_id"],
+                parent_run_id=agent["parent_run_id"], available_at=_now(),
+                owner="ManagerResearchJobService.import_announcement_analysis", **FLAGS)
+            owner_receipt["sha256"] = digest(owner_receipt)
+            validate_owner_analysis_import_receipt(owner_receipt, product)
+            service.store._write_atomic(owner_path, owner_receipt)
+        receipt_readback = validate_owner_analysis_import_receipt(service.store._read(owner_path), product)
+        if receipt_readback != owner_receipt:
+            raise ValueError("ANNOUNCEMENT_ANALYSIS_OWNER_RECEIPT_READBACK_FAILED")
+        result = service.get_announcement_analysis(target, publication)
+        if result.get("analysis", {}).get("product_sha256") != product["sha256"]:
+            raise ValueError("ANNOUNCEMENT_ANALYSIS_FINAL_READBACK_FAILED")
+        result.update(owner_import_receipt=receipt_readback, import_status=imported.get("import_status"),
+            handoff_manifest_sha256=envelope["handoff_manifest_sha256"], evidence_run_id=envelope["evidence_run_id"])
+        result["consumption_validation"] = read_analysis_consumption(service, target, publication,
+            analysis_readback=result)
+        if result["consumption_validation"]["validation_status"] != "VERIFIED":
+            raise ValueError("ANNOUNCEMENT_ANALYSIS_FINAL_CONSUMPTION_VALIDATION_FAILED")
+        return result
+
+
 def read(service: Any, target_trade_date: str,
