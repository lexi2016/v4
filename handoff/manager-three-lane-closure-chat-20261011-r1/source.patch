+def _excluded_by_late_attempt(store: Any, date: str, name: str,
+                              boundary: Mapping[str, Any]) -> tuple[bool, int]:
+    """Use the original exact-run journal only to exclude a late owner run.
+
+    A consumable plan must satisfy started_at <= generated_at in the original
+    owner_plan_readback validator. Thus an exact, valid successful attempt
+    started after the historical boundary cannot yield an eligible plan.
+    This never admits a body, trusts attempt latest, creates an index, or
+    substitutes receipt metadata for the product SHA/window/owner checks.
+    """
