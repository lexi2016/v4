+def _regular_snapshot(path: Path) -> tuple[bytes, int]:
+    """Read through one descriptor, without following a final symlink."""
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, "rb") as handle:
