+def _candidate_runtime_identity(plan: Mapping[str, Any]) -> dict[str, Any]:
+    return {"state": "running", "V35_RELEASE_ID": plan["target"]["release_id"],
+        "V35_APP_ROOT": plan["target"]["app_root"],
+        "V35_RELEASE_MANIFEST_SHA256": plan["target"]["release_manifest_sha256"]}
+
