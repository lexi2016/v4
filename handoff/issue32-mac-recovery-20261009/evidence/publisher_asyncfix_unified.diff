+def _wait_for_unloaded(expected_identities: Sequence[Mapping[str, Any]], *,
+                       timeout_s: int = 30) -> dict[str, Any]:
+    """Wait for launchd to confirm the exact label absent after bootout.
+
+    `launchctl bootout` returns before macOS has necessarily removed the job.
+    Intermediate `LOADED_UNVERIFIED` states are waited out; a running job is
+    accepted as transitional only when its runtime identity belongs to this
+    recorded transaction. Unknown identity/state and timeout remain failures.
+    """
+    if timeout_s <= 0 or not expected_identities:
+        raise ValueError("API_ONLY_BOOTOUT_WAIT_ARGUMENTS_INVALID")
+    deadline = time.monotonic() + timeout_s
+    poll_count = 0
+    last: dict[str, Any] | None = None
+    while True:
+        observed = _observe_loaded()
+        poll_count += 1
+        state = observed.get("state")
+        if state == "NOT_LOADED":
+            return {**observed, "poll_count": poll_count, "wait_status": "ABSENT_CONFIRMED"}
+        if state == "LOADED":
+            identity = observed.get("identity")
+            if (not isinstance(identity, Mapping) or not identity.get("pid")
+                    or not any(_identity_matches(identity, expected) for expected in expected_identities)):
+                raise ValueError("API_ONLY_BOOTOUT_REFUSES_UNKNOWN_LOADED_IDENTITY:" + str(observed))
+        elif state != "LOADED_UNVERIFIED":
+            raise ValueError("API_ONLY_BOOTOUT_STATE_UNVERIFIED:" + str(observed))
+        last = observed
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise ValueError("API_ONLY_BOOTOUT_ABSENCE_TIMEOUT:" + str(last))
+        time.sleep(min(0.5, remaining))
+
+
+def _wait_for_recovery_transition(plan: Mapping[str, Any], *,
+                                  timeout_s: int = 30) -> tuple[dict[str, Any], str]:
+    """Resolve a launchd transition to absence or one recorded transaction identity."""
+    if timeout_s <= 0:
+        raise ValueError("API_ONLY_RECOVERY_WAIT_ARGUMENT_INVALID")
+    old_identity = plan["before"]["loaded_identity"]
+    candidate_identity = _candidate_runtime_identity(plan)
+    deadline = time.monotonic() + timeout_s
+    poll_count = 0
+    last: dict[str, Any] | None = None
+    while True:
+        observed = _observe_loaded()
+        poll_count += 1
+        state = observed.get("state")
+        if state == "NOT_LOADED":
+            return ({**observed, "poll_count": poll_count,
+                     "transition_wait_status": "ABSENT_CONFIRMED"}, "unloaded")
+        if state == "LOADED":
+            identity = observed.get("identity")
+            if not isinstance(identity, Mapping) or not identity.get("pid"):
+                raise ValueError("API_ONLY_RECOVERY_RUNTIME_STATE_UNVERIFIED:" + str(observed))
+            if _identity_matches(identity, old_identity):
+                return (observed, "original")
+            if _identity_matches(identity, candidate_identity):
+                return (observed, "candidate")
+            raise ValueError("API_ONLY_ROLLBACK_REFUSES_UNKNOWN_LOADED_IDENTITY")
+        if state != "LOADED_UNVERIFIED":
+            raise ValueError("API_ONLY_RECOVERY_RUNTIME_STATE_UNVERIFIED:" + str(observed))
+        last = observed
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            raise ValueError("API_ONLY_RECOVERY_RUNTIME_TRANSITION_TIMEOUT:" + str(last))
+        time.sleep(min(0.5, remaining))
+
