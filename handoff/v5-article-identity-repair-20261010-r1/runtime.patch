+                raise ValueError('BUILDER_V1_OWNER_IO_BOUNDARY')
+            return True  # Only the already byte-bound summary is visible.
+        def read_bytes(self):
+            if str(self) != str(root) + '/' + source_name:
+                raise ValueError('BUILDER_V1_OWNER_IO_BOUNDARY')
