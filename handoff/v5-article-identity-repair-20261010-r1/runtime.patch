+                        allow_late_observations and field in _v4_global(_v4_scope, '_HOURLY_OBSERVATION_TIMES')
+                    ):
+                        raise _v4_global(_v4_scope, 'ValueError')("HOURLY_SOURCE_ROW_PIT_MISMATCH:" + name + "." + field)
