+        cutoff = contract["STAGE_BY_ID"][stage_id].cutoff
+        evaluated = datetime.strptime(pin["trade_date"] + " " + cutoff, "%Y%m%d %H:%M:%S").replace(tzinfo=ZoneInfo("Asia/Shanghai"))
