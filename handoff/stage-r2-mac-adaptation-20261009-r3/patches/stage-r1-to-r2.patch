+def _read_current_day_research(_v4_scope, root, trade_date):
+    """Read four pinned files; provider receipts remain opaque source bytes.
+
+    The separate pin is an explicit operator binding. It does not rewrite a
+    provider receipt or certify historical Connect eligibility/PIT. The
+    security array contributes no price, volume, lane, model, or D1 fields.
+    """
+    from zoneinfo import ZoneInfo
+
+    Path = _v4_global(_v4_scope, 'Path')
+    json = _v4_global(_v4_scope, 'json')
+    re = _v4_global(_v4_scope, 're')
+    datetime = _v4_global(_v4_scope, 'datetime')
+    error_type = _v4_global(_v4_scope, 'RunnerError')
+    root = Path(root).expanduser().resolve()
+    pin_path = root / "CURRENT_DAY_RESEARCH_PIN.json"
+
+    def reject(reason):
+        raise error_type(f"HK_CURRENT_DAY_RESEARCH_{reason}")
+
+    def read_json(path):
+        if path.is_symlink() or path.parent != root:
+            reject(f"PATH_INVALID:{path.name}")
+        try:
+            raw = path.read_bytes()
+            return raw, json.loads(raw.decode("utf-8"))
+        except (OSError, UnicodeError, ValueError) as error:
+            raise error_type(f"HK_CURRENT_DAY_RESEARCH_INPUT_UNREADABLE:{path.name}") from error
+
+    pin_bytes, pin = read_json(pin_path)
+    if not isinstance(pin, dict):
+        reject("PIN_INVALID")
+    if (pin.get("schema_version") != "v4.hk_current_day_research_pin.v1"
+            or pin.get("mode") != "CURRENT_DAY_RESEARCH_ONLY"
+            or pin.get("market") != "HK_CONNECT"
+            or pin.get("trade_date") != trade_date
+            or pin.get("hk_connect_membership_status") != "CANNOT_CONFIRM"
+            or pin.get("formal_d1_eligible") is not False
+            or pin.get("formal_pit") is not False
+            or any(pin.get(flag) is not False for flag in _v4_global(_v4_scope, 'SAFETY_FLAGS'))):
+        reject("PIN_IDENTITY_OR_SAFETY_INVALID")
+    universe_as_of = pin.get("universe_as_of")
+    captured_at = pin.get("captured_at")
+    try:
+        if not re.fullmatch(r"\d{8}", str(trade_date)) or not re.fullmatch(r"\d{8}", str(universe_as_of)):
+            reject("DATE_INVALID")
+        datetime.strptime(trade_date, "%Y%m%d")
+        datetime.strptime(universe_as_of, "%Y%m%d")
+        captured = datetime.fromisoformat(captured_at)
+        if (captured.tzinfo is None
+                or captured.astimezone(ZoneInfo("Asia/Hong_Kong")).strftime("%Y%m%d") != trade_date
+                or universe_as_of > trade_date
+                or pin.get("stale_universe") is not (universe_as_of < trade_date)):
+            reject("DATE_INVALID")
+    except (TypeError, ValueError) as error:
+        raise error_type("HK_CURRENT_DAY_RESEARCH_DATE_INVALID") from error
+    row_count = pin.get("row_count")
+    if type(row_count) is not int or row_count < 1:
+        reject("ROW_COUNT_INVALID")
+    reference_name = f"reference_codes_{universe_as_of}.json"
+    expected_files = {"snapshot_rows_projected.json", "receipt.json", reference_name, "FINAL_RECEIPT.json"}
+    file_pins = pin.get("files")
+    if (not isinstance(file_pins, dict) or set(file_pins) != expected_files
+            or any(not re.fullmatch(r"[0-9a-f]{64}", str(value)) for value in file_pins.values())):
+        reject("FILE_PINS_INVALID")
+    payloads = {}
+    for filename in sorted(expected_files):
+        raw, payloads[filename] = read_json(root / filename)
+        if _v4_global(_v4_scope, 'hashlib').sha256(raw).hexdigest() != file_pins[filename]:
+            reject(f"SHA_MISMATCH:{filename}")
+    if pin_path.read_bytes() != pin_bytes:
+        reject("PIN_CHANGED_DURING_READ")
+    rows = payloads["snapshot_rows_projected.json"]
+    fields = {"code", "name", "outstanding_shares", "circular_market_val", "listing_date",
+              "lot_size", "stock_owner", "stock_child_type", "sec_status"}
+    if not isinstance(rows, list) or len(rows) != row_count:
+        reject("ROW_COUNT_MISMATCH")
+    if any(not isinstance(row, dict) or not set(row).issubset(fields) for row in rows):
+        reject("SECURITY_FIELDS_INVALID")
+    codes = tuple(row.get("code") for row in rows)
+    if (any(not isinstance(code, str) or not re.fullmatch(r"HK\.\d{5}", code) for code in codes)
+            or len(set(codes)) != row_count):
+        reject("SECURITY_CODES_INVALID")
+    reference = payloads[reference_name]
+    # Accepted consumer shapes are an array, or an object with a codes array.
+    # Other provider shapes remain explicit CANNOT_CONFIRM until inspected.
+    reference = reference.get("codes") if isinstance(reference, dict) else reference
+    if (not isinstance(reference, list)
+            or any(not isinstance(code, str) or not re.fullmatch(r"HK\.\d{5}", code) for code in reference)
+            or len(reference) != row_count or len(set(reference)) != row_count
+            or set(reference) != set(codes)):
+        reject("CODE_SET_MISMATCH")
+    pin_sha = _v4_global(_v4_scope, 'hashlib').sha256(pin_bytes).hexdigest()
+    research_source = {
+        "schema_version": "HK_CURRENT_DAY_RESEARCH_V1",
+        "mode": "CURRENT_DAY_RESEARCH_ONLY", "market": "HK_CONNECT", "trade_date": trade_date,
+        "universe_as_of": universe_as_of, "captured_at": captured_at,
+        "stale_universe": pin["stale_universe"], "hk_connect_membership_status": "CANNOT_CONFIRM",
+        "formal_d1_eligible": False, "formal_pit": False,
+        "source_sha256": pin_sha, "input_sha256": dict(file_pins),
+    }
+    evidence = (
+        "research_source=" + json.dumps(research_source, ensure_ascii=False, sort_keys=True, separators=(",", ":")),
+        f"hk_research_root={root}", f"hk_research_binding_sha256={pin_sha}",
+        "hk_selection_mode=CURRENT_DAY_RESEARCH_ONLY", "hk_connect_eligibility=CANNOT_CONFIRM",
+        "security_metadata_only=true", "formal_pit=false",
+        "production_allowed=false", "buy_gate_updated=false", "orders_sent=false",
+    )
+    binding = _v4_global(_v4_scope, 'StageUniverseBinding').ready(
+        market="HK_CONNECT", trade_date=trade_date, role="HK_CURRENT_DAY_RESEARCH",
+        codes=codes, source_run_id=f"hk-current-research-{pin_sha[:16]}", sha256=pin_sha, evidence=evidence,
+    )
+    return binding, tuple(dict(row) for row in rows)
+
+
+def _read_bound_current_day_research(_v4_scope, binding, trade_date):
+    roots = [str(item).partition("=")[2] for item in binding.evidence
+             if str(item).startswith("hk_research_root=")]
+    if len(roots) != 1:
+        raise _v4_global(_v4_scope, 'RunnerError')("HK_CURRENT_DAY_RESEARCH_BINDING_INVALID")
+    fresh, rows = _read_current_day_research(_v4_scope, roots[0], trade_date)
+    if fresh != binding:
+        raise _v4_global(_v4_scope, 'RunnerError')("HK_CURRENT_DAY_RESEARCH_BINDING_CHANGED")
+    return fresh, rows
 
 
