+def _runtime_source_identity(scope):
+    """Record loaded-module paths and observed bytes, not memory attestation.
+
+    The candidate/deployment manifests remain the authority for approved
+    bytes. This owner observation makes the actual loaded paths reviewable
+    inside the same immutable receipt as input and selection identities.
+    """
+    import hashlib
+    import json
+    import sys
+    from pathlib import Path
+
+    path = scope.get("__file__")
+    if not path:
+        return {"scope": "LOADED_MODULE_PATHS_AND_OBSERVED_FILE_BYTES",
+                "status": "CANNOT_CONFIRM", "memory_execution_attested": False,
+                "files": {}, "cannot_confirm": ["RUNNER_MODULE_PATH_UNAVAILABLE"]}
+    app = Path(path).resolve().parent.parent
+    files, gaps = {}, []
+    for name, module in sorted(tuple(sys.modules.items())):
+        source = getattr(module, "__file__", None)
+        if not source:
+            continue
+        try:
+            loaded = Path(source).resolve()
+            relative = loaded.relative_to(app).as_posix()
+        except (OSError, ValueError):
+            # Observe the loaded Python files belonging to this application,
+            # including lazily named shared-bridge modules; exclude packages
+            # outside its source root instead of assigning their bytes here.
+            continue
+        try:
+            if loaded.suffix != ".py":
+                continue
+            files[relative] = {"module": name, "loaded_path": str(loaded),
+                               "sha256": hashlib.sha256(loaded.read_bytes()).hexdigest()}
+        except (OSError, ValueError):
+            gaps.append(f"LOADED_MODULE_SOURCE_UNAVAILABLE:{name}")
+    identity = {rel: item["sha256"] for rel, item in sorted(files.items())}
+    raw = json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()
+    return {"scope": "LOADED_MODULE_PATHS_AND_OBSERVED_FILE_BYTES",
+            "status": "OBSERVED" if files and not gaps else "CANNOT_CONFIRM",
+            "source_root": str(app), "source_set_sha256": hashlib.sha256(raw).hexdigest(),
+            "memory_execution_attested": False, "files": files, "cannot_confirm": gaps}
