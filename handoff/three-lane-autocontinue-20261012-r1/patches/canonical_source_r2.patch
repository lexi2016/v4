+def _safe_history_failure_code(error: BaseException) -> str | None:
+    """Recover a stable original owner code without printing paths or data.
+
+    One bounded chained cause lets an owner attempt failure retain its actual
+    failure code when read_history wraps the public HISTORY_* envelope.
+    The original message is never emitted for free-form exceptions.
+    """
+    candidate: BaseException | None = error
+    deepest_code = None
+    for _ in range(3):
+        if candidate is None:
+            break
+        value = str(candidate)
+        if type(candidate) is ValueError and re.fullmatch(r'[A-Z][A-Z0-9_]{4,127}', value):
+            deepest_code = value
+        candidate = candidate.__cause__
+    return deepest_code
+
