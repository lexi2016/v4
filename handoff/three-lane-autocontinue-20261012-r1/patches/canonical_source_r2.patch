+        "execution_kind_source": "OWNER_READBACK",
+        "owner_attempt_run_id": attempt["run_id"], "owner_attempt_sha256": attempt["sha256"],
+        "owner_attempt_state": attempt["state"], "owner_finished_at": attempt["finished_at"],
