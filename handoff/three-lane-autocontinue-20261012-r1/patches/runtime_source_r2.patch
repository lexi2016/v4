+def read_original_stage_selection(service: Any, trade_date: str) -> dict[str, Any]:
+    """Read exact formal HK Stage from the *existing* SelectionStore consumer.
+
+    An observation-reader Stage DTO is NOT a selection-consumer response. The
+    consumer must be explicitly injected by the existing API owner; this
+    function never guesses storage roots, selects a backfill, or produces a
+    selection. All unbound/failing cases keep the candidate count unknown.
+    """
+    reader = getattr(service, '_workspace_stage_selection_reader', None)
+    if reader is None:
+        return {'markets': {}, 'readback_error': 'HK_STAGE_SELECTION_CONSUMER_NOT_BOUND'}
+    getter = getattr(reader, 'get', None)
+    if not callable(getter):
+        return {'markets': {}, 'readback_error': 'HK_STAGE_SELECTION_CONSUMER_INVALID'}
+    try:
+        response = getter(trade_date, 'STAGE_0925', markets=('HK_CONNECT',),
+                          allow_backfill=False)
+    except (ImportError, OSError, ValueError, KeyError, TypeError, RuntimeError,
+            TimeoutError, AttributeError) as exc:
+        return {'markets': {}, 'readback_error':
+                'HK_STAGE_SELECTION_OWNER_READ_FAILED:' + type(exc).__name__}
+    if not isinstance(response, Mapping):
+        return {'markets': {}, 'readback_error': 'HK_STAGE_SELECTION_RESPONSE_NOT_OBJECT'}
+    return stage_selection_readback(response)
+
