+def _configured_symbol_metadata() -> dict[str, dict[str, Any]]:
+    """Use the peripheral owner's existing 33-symbol proxy configuration."""
+    result: dict[str, dict[str, Any]] = {}
+    for definition in CANONICAL_GLOBAL_INDUSTRY_PROXY_MAP:
+        for raw_symbol in definition.get("proxy_symbols", ()):
+            symbol = str(raw_symbol).upper()
+            row = result.setdefault(symbol, {"symbol": symbol, "proxy_labels": [], "proxy_mapping_types": []})
+            label = definition.get("label")
+            mapping_type = definition.get("mapping_type")
+            if isinstance(label, str) and label not in row["proxy_labels"]:
+                row["proxy_labels"].append(label)
+            if isinstance(mapping_type, str) and mapping_type not in row["proxy_mapping_types"]:
+                row["proxy_mapping_types"].append(mapping_type)
+    for row in result.values():
+        row["instrument_classification"] = (
+            "ETF_PROXY" if all(str(item).startswith("etf_") for item in row["proxy_mapping_types"])
+            else "EQUITY_PROXY" if row["proxy_mapping_types"] and all(
+                str(item).startswith("stock_") for item in row["proxy_mapping_types"])
+            else "MIXED_OR_UNVERIFIED_PROXY_CLASS"
+        )
+    return result
+
