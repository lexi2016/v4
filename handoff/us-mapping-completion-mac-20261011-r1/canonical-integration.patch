+    """Retain a per-symbol quote and relation-state row, including non-movers."""
+    metadata = _configured_symbol_metadata()
+    by_symbol: dict[str, list[Mapping[str, Any]]] = {symbol: [] for symbol in metadata}
+    for quote in quotes:
+        if not isinstance(quote, Mapping):
+            continue
+        symbol = str(quote.get("symbol") or "").upper()
+        if symbol in by_symbol and str(quote.get("session_date") or "") == session_date:
+            by_symbol[symbol].append(quote)
+
+    result: list[dict[str, Any]] = []
+    for symbol in sorted(metadata):
+        matches = by_symbol[symbol]
+        quote = matches[0] if len(matches) == 1 else None
+        change = _finite(quote.get("change_pct")) if quote is not None else None
+        if not matches:
+            quote_status, direction = "QUOTE_MISSING", "UNKNOWN"
+        elif len(matches) != 1:
+            quote_status, direction = "QUOTE_DUPLICATE", "UNKNOWN"
+        elif change is None:
+            quote_status, direction = "QUOTE_CHANGE_INVALID", "UNKNOWN"
+        elif not source_is_eligible:
+            quote_status, direction = "CANNOT_CONFIRM", "UNKNOWN"
+        else:
+            quote_status = "VERIFIED"
+            direction = "UP" if change > 0 else "DOWN" if change < 0 else "FLAT"
+        evidence = None
+        if quote is not None:
+            evidence = {
+                "session_date": session_date,
+                "session_time": str(quote.get("session_time") or ""),
+                "change_pct": change,
+                "provider": str(quote.get("provider") or ""),
+                "source_payload_sha256": source_payload_sha256,
+            }
+        result.append({
+            **deepcopy(metadata[symbol]),
+            "quote_status": quote_status,
+            "direction": direction,
+            "quote_evidence": evidence,
+            "relation_assessment_status": "NOT_EVALUATED",
+            "relation_count": None,
+            "relations": [],
+            "relation_gaps": ["VERIFIED_RELATION_EVIDENCE_NOT_BOUND"],
+            "target_date_eligibility": "CANNOT_CONFIRM",
+            "RESEARCH_ONLY": True,
+            "production_allowed": False,
+            "buy_gate_updated": False,
+            "orders_sent": False,
+        })
+    return result
