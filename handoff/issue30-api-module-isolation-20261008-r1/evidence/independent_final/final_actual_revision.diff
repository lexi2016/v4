+        return
+    reference = transaction["reference"]
+    raw = _regular_file(Path(reference["path"]), "API_ONLY_PREPARED_RECEIPT")
+    if _sha(raw) != reference["sha256"]:
+        raise ValueError("API_ONLY_PREPARED_RECEIPT_SHA_MISMATCH")
+    if transaction.get("source_receipt_path") is not None:
+        source = _regular_file(Path(transaction["source_receipt_path"]), "API_ONLY_RECOVERY_SOURCE_RECEIPT")
+        if _sha(source) != transaction["source_receipt_sha256"]:
+            raise ValueError("API_ONLY_RECOVERY_SOURCE_RECEIPT_CHANGED")
