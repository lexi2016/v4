+def _signed_receipt(path: Path, label: str) -> tuple[dict[str, Any], str]:
+    raw = _regular_file(path, label)
+    try:
+        receipt = json.loads(raw.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError(label + "_JSON_INVALID") from exc
+    if not isinstance(receipt, dict):
+        raise ValueError(label + "_JSON_OBJECT_REQUIRED")
+    unsigned = {key: value for key, value in receipt.items() if key != "receipt_sha256"}
+    if receipt.get("receipt_sha256") != _canonical_sha(unsigned):
+        raise ValueError(label + "_SHA_MISMATCH")
+    return receipt, _sha(raw)
+
