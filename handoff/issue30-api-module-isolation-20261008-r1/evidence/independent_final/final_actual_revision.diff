+def _record(path: Path, status: str, details: Mapping[str, Any], *,
+            prepared_transaction: Mapping[str, Any] | None = None) -> dict[str, Any]:
+    payload = dict(details)
+    if prepared_transaction is not None:
+        prepared = prepared_transaction["record"]
+        for key in _PREPARED_CONTRACT_KEYS:
+            if key in payload and not _contract_value_matches(key, payload[key], prepared):
+                raise ValueError("API_ONLY_PREPARED_CONTRACT_MISMATCH:" + key)
+            payload.setdefault(key, prepared[key])
+        payload["prepared_receipt"] = dict(prepared_transaction["reference"])
+        if prepared_transaction.get("source_receipt_path") is not None:
+            payload["resumed_from_receipt"] = {
+                "path": prepared_transaction["source_receipt_path"],
+                "sha256": prepared_transaction["source_receipt_sha256"],
+            }
+            payload["recovery_expected_current_plist_sha256"] = prepared_transaction["expected_current_sha"]
+    receipt = _receipt_record(status, payload)
     _write_receipt(path, receipt)
     return _read_json(path, "API_ONLY_OPERATION_RECEIPT")
