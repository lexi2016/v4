+def _recovery_state(plan: Mapping[str, Any], candidate_plist_sha: str, *,
+                     expected_current_sha: str | None = None) -> tuple[str, dict[str, Any], str]:
+    if (ACTIVE_API_PLIST.is_symlink()
+            or (ACTIVE_API_PLIST.exists() and not ACTIVE_API_PLIST.is_file())):
+        raise ValueError("API_ONLY_ROLLBACK_ACTIVE_PLIST_PATH_UNAVAILABLE")
+    current_sha = (_sha(_regular_file(ACTIVE_API_PLIST, "API_ONLY_ROLLBACK_ACTIVE_PLIST"))
+                   if ACTIVE_API_PLIST.exists() else "ABSENT")
+    if current_sha not in {"ABSENT", plan["before"]["active_api_plist_sha256"], candidate_plist_sha}:
+        raise ValueError("API_ONLY_ROLLBACK_ACTIVE_PLIST_UNEXPECTED_SHA")
+    if expected_current_sha is not None:
+        if (not isinstance(expected_current_sha, str)
+                or (expected_current_sha != "ABSENT"
+                    and re.fullmatch(r"[0-9a-f]{64}", expected_current_sha) is None)):
+            raise ValueError("API_ONLY_ROLLBACK_EXPECTED_CURRENT_SHA_INVALID")
+        if current_sha != expected_current_sha:
+            raise ValueError("API_ONLY_ROLLBACK_CURRENT_PLIST_PREIMAGE_MISMATCH")
+    observed = _observe_loaded()
+    if observed.get("state") == "NOT_LOADED":
+        return current_sha, observed, "unloaded"
+    if observed.get("state") != "LOADED":
+        raise ValueError("API_ONLY_ROLLBACK_RUNTIME_STATE_UNVERIFIED:" + str(observed))
+    identity = observed.get("identity")
+    if not isinstance(identity, dict) or not identity.get("pid"):
+        raise ValueError("API_ONLY_ROLLBACK_RUNTIME_STATE_UNVERIFIED:" + str(observed))
+    if _identity_matches(identity, plan["before"]["loaded_identity"]):
+        return current_sha, observed, "original"
+    candidate_identity = {"state": "running", "V35_RELEASE_ID": plan["target"]["release_id"],
+        "V35_APP_ROOT": plan["target"]["app_root"],
+        "V35_RELEASE_MANIFEST_SHA256": plan["target"]["release_manifest_sha256"]}
+    if _identity_matches(identity, candidate_identity):
+        return current_sha, observed, "candidate"
+    raise ValueError("API_ONLY_ROLLBACK_REFUSES_UNKNOWN_LOADED_IDENTITY")
+
