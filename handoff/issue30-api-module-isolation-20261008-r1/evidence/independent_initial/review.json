  "findings": [
    {
      "id": "R1",
      "severity": "Important",
      "status": "OPEN_ACCEPTED_FOR_REVISION",
      "title": "Git-tracked module additions cannot use the API builder",
      "locations": [
        "candidate/ops/api_release_integration.py:731-734",
        "candidate/ops/build_release_candidate.py:420-434",
        "candidate/ops/release_candidate_sources.py:68-78"
      ],
      "problem": "The core requires all additions absent from active to equal explicit_untracked_paths, while the builder rejects any tracked path in that list. A reviewed preselection_service.py that has been git added/committed is rejected both with and without the option. Git tracking state should not invalidate a fully pinned, owned module addition.",
      "expected": "Allow receipt-declared tracked additions; retain explicit approval and exact scope validation for current untracked source files.",
      "test": "test_release_review_probes.py::test_committed_reviewed_module_addition_can_be_built",
      "observed": "2 failures: EXACT_UNTRACKED_APPROVAL without option, already tracked with option.",
      "evidence": [
        "release_probes.log",
        "release_probes.xml",
        "release_probes_run.json"
      ]
    },
    {
      "id": "R2",
      "severity": "Important",
      "status": "OPEN_ACCEPTED_FOR_REVISION",
      "title": "Scheduler staging follows a late candidate config symlink outside the candidate",
      "locations": [
        "candidate/ops/build_release_candidate.py:569-571",
        "candidate/ops/build_release_candidate_stage.py:181-184"
      ],
      "problem": "After render_cutover has safely staged config, replacing candidate/config with a symlink causes the subsequent historical scheduler helper to mkdir/open through it and write com.lexi.v35.scheduler.plist outside the candidate. Final API integration only checks app, and the builder can return success. The historical helper is an active write dependency of this product entrypoint.",
      "expected": "Keep every builder output write anchored to verified candidate directory descriptors and reject an aliased/replaced config before any outside write.",
      "test": "test_release_review_probes.py::test_scheduler_staging_cannot_follow_late_config_symlink",
      "observed": "1 failure: outside-config/com.lexi.v35.scheduler.plist exists after the build.",
      "evidence": [
        "config_escape.log",
        "config_escape.xml",
        "config_escape_run.json"
      ]
    },
    {
      "id": "R3",
      "severity": "Important",
      "status": "OPEN_ACCEPTED_FOR_REVISION",
      "title": "Non-delta directory preservation is not bound by candidate verification",
      "locations": [
        "candidate/ops/api_release_integration.py:_inventory_snapshot",
        "candidate/ops/api_release_integration.py:_verify_delta_files",
        "candidate/ops/api_release_integration.py:_candidate_identity"
      ],
      "problem": "Directory modes are copied at build time but omitted from manifest inventory and base-versus-candidate comparison. A post-build chmod of candidate/app/apps/api from 0755 to 0777 passes verification with unchanged files, manifest and receipt. Current-call physical snapshots only establish self-consistency. Empty directory set preservation has the same structural omission; the recorded minimal runtime probe tests mode changes.",
      "expected": "Bind and compare original directory set and mode, including app root and empty directories; allow only clearly scoped new ancestors required by allowed additions.",
      "test": "test_release_review_probes.py::test_verifier_rejects_undeclared_directory_mode_change",
      "observed": "1 failure: expected rejection, verify_api_release_candidate returned PASS.",
      "evidence": [
        "release_probes.log",
        "release_probes.xml",
        "release_probes_run.json"
      ]
    },
    {
      "id": "R4",
      "severity": "Important",
      "status": "OPEN_ACCEPTED_FOR_REVISION",
      "title": "Legacy SHA recovery promotes inconsistent market/code identities as valid A rows",
      "locations": [
        "work/preselection_scope/after/apps/api/v35_api/preselection_service.py:316-325"
      ],
      "problem": "The newly reachable recovery calls the historical _canonical_a_symbol helper, which can ignore contradictory market or symbol fields. A row with market=US and symbol=A.000020, or market=A plus symbol=HK.00700 and code=000020, is accepted as the only valid A input after another pool SHA failure. Both return PARTIAL_WITH_ROWS and A count 1; the contradictory HK symbol can be rewritten to A.000020. Strict trio SHA does not prove semantic identity consistency.",
      "expected": "Validate every present market/code identity field as a consistent A identity before counting/recovering; quarantine inconsistent inputs, retain the original block if no valid A remains, and preserve all source bytes.",
      "test": "test_preselection_review_probes.py::test_sha_recovery_does_not_promote_inconsistent_market_identity",
      "observed": "2 failures: both inconsistent rows promoted; source JSON hashes unchanged.",
      "evidence": [
        "preselection_identity_probes.log",
        "preselection_identity_probes.xml",
        "preselection_identity_probes_run.json"
      ]
    },
    {
      "id": "R5",
      "severity": "Important",
      "status": "OPEN_ACCEPTED_FOR_REVISION",
      "title": "An interrupted automatic rollback has no protected operator recovery continuation",
      "locations": [
        "work/cutover_analysis/candidate/api_only_cutover_r2_ready.py:1570-1578",
        "work/cutover_analysis/candidate/api_only_cutover_r2_ready.py:1721-1722"
      ],
      "problem": "A simulated candidate bootstrap failure followed by a transient restore rename failure leaves the candidate plist and no loaded service, with an intact original backup. The operation receipt is overwritten as ROLLBACK_INCOMPLETE without the full prepared before/after/integration/base contract. After the transient fault clears, the public rollback entrypoint rejects that receipt because it accepts only successful switches. Execute cannot resume from the candidate pointer either.",
      "expected": "Preserve the prepared transaction and exact original base contract across failures. Provide an explicit guarded continuation for prepared/incomplete operations that still validates the shared lease, receipt, backup, known pointer and known/unloaded runtime; keep unknown identities rejected. Interface details belong to the writer.",
      "test": "test_actual_review_probes.py::test_operator_can_resume_after_transient_automatic_restore_failure",
      "observed": "1 failure: API_ONLY_ROLLBACK_RECEIPT_IDENTITY_INVALID after both injected faults are removed; preimage is intact and current pointer is still the known candidate.",
      "evidence": [
        "actual_recovery_probe.log",
        "actual_recovery_probe.xml",
        "actual_recovery_probe_run.json"
      ]
    }
  ],
