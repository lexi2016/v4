+def _require_release_lock(lock_lease: object | None) -> Any:
+    if lock_lease is None:
+        raise ValueError("API_RELEASE_SHARED_LOCK_REQUIRED")
+    bound = _INTEGRATION_GUARD_LEASES.get(id(lock_lease))
+    if bound is None or bound[0] is not lock_lease:
+        raise ValueError("API_RELEASE_SHARED_LOCK_LEASE_NOT_FROM_THIS_EXECUTION")
+    # Keep the exact verified module for this transaction, including recovery.
+    # Reopening the helper here could make a failed switch unrecoverable if an
+    # unrelated source update replaced the on-disk helper after bootout.
+    guard = bound[1]
+    guard.assert_api_release_lock(lock_lease, ACTIVE_API_PLIST)
+    return guard
