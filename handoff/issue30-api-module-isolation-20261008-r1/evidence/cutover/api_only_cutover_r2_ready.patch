+def _load_integration_guard() -> Any:
+    """Execute exactly the pinned bytes; never reopen them through an import loader."""
+    global _INTEGRATION_GUARD_CACHE
+    if not re.fullmatch(r"[0-9a-f]{64}", INTEGRATION_GUARD_SHA256):
+        raise ValueError("API_ONLY_INTEGRATION_GUARD_SHA_NOT_FROZEN")
+    path = INTEGRATION_GUARD_PATH
+    raw = _regular_file(path, "API_ONLY_INTEGRATION_GUARD")
+    if _sha(raw) != INTEGRATION_GUARD_SHA256:
+        raise ValueError("API_ONLY_INTEGRATION_GUARD_SHA_MISMATCH")
+    identity = (str(path), INTEGRATION_GUARD_SHA256)
+    if _INTEGRATION_GUARD_CACHE is not None and _INTEGRATION_GUARD_CACHE[0] == identity:
+        return _INTEGRATION_GUARD_CACHE[1]
+    # A unique registry name supports dataclasses without reusing a module from
+    # sys.modules or importing a task-local or environment-selected namesake.
+    name = "_v4_api_guard_" + INTEGRATION_GUARD_SHA256[:16] + "_" + uuid.uuid4().hex
+    module = types.ModuleType(name)
+    module.__file__ = str(path)
+    sys.modules[name] = module
+    try:
+        exec(compile(raw, str(path), "exec"), module.__dict__)
+        required = ("inventory_tree", "inventory_digest", "verify_api_release_candidate",
+                    "verify_recorded_base", "shared_api_release_lock", "assert_api_release_lock")
+        if (getattr(module, "SCHEMA_VERSION", None) != "v4.api_release_integration.v2"
+                or any(not callable(getattr(module, key, None)) for key in required)):
+            raise ValueError("API_ONLY_INTEGRATION_GUARD_INTERFACE_INVALID")
+    except BaseException:
+        sys.modules.pop(name, None)
+        raise
+    _INTEGRATION_GUARD_CACHE = (identity, module)
+    return module
+
