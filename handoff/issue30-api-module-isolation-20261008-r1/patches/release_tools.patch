+def _absolute_path(path: Path) -> Path:
+    supplied = Path(path).expanduser()
+    if ".." in supplied.parts:
+        raise ValueError("API_RELEASE_PATH_NOT_CANONICAL")
+    return Path(os.path.abspath(supplied))
+
