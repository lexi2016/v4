+def _receipt_record(status: str, details: Mapping[str, Any]) -> dict[str, Any]:
+    return {"schema_version": RECEIPT_SCHEMA, "status": status,
+            "recorded_at_utc": datetime.now(timezone.utc).isoformat(timespec="seconds"),
+            "active_api_plist": str(ACTIVE_API_PLIST), "active_label": LABEL,
+            "scheduler_action": "UNCHANGED", "formal_manager_state_action": "READ_ONLY",
+            "production_allowed": False, "buy_gate_updated": False, "orders_sent": False,
+            **dict(details)}
