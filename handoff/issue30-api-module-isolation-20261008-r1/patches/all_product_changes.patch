+def _contract_value_matches(key: str, value: Any, prepared: Mapping[str, Any]) -> bool:
+    if key == "after" and isinstance(value, dict) and isinstance(prepared.get(key), dict):
+        # Successful runtime readback may append this observation. It cannot
+        # replace any part of the already-frozen candidate identity.
+        return ({k: v for k, v in value.items() if k != "loaded_identity"} == prepared[key])
+    return key in prepared and value == prepared[key]
+
