+                                  details: Mapping[str, Any], *,
+                                  lock_lease: object) -> dict[str, Any]:
+    _require_release_lock(lock_lease)
+    prepared = _receipt_record("PREPARED", {**dict(details),
+        "plan_sha256": _canonical_sha(plan), "origin_operation_dir": str(operation_dir)})
+    if any(key not in prepared for key in _PREPARED_CONTRACT_KEYS):
+        raise ValueError("API_ONLY_PREPARED_CONTRACT_INCOMPLETE")
+    path = operation_dir / "prepared_receipt.json"
+    raw = _receipt_bytes(prepared)
