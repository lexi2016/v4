+def _run_daily_supplement(_v4_scope, *, args, authority_paths, target, python_executable):
+    updater = Path(authority_paths["--hk-updater-script"]).expanduser().resolve()
+    package_root = updater.parents[1]
+    original_owner = package_root / "shared_data" / "hk_daily_supplement.py"
+    if not original_owner.is_file():
+        return {"status": "CANNOT_CONFIRM", "target_date": target,
+                "reason_code": "HK_DAILY_SUPPLEMENT_OWNER_UNAVAILABLE"}
+    argv = [str(python_executable), str(updater), "--asset-root",
+        str(Path(args.hk_asset_root).expanduser().resolve()), "--tdx-root",
+        str(Path(args.hk_tdx_root).expanduser().resolve()), "--through-date", target,
+        "--daily-supplement"]
+    try:
+        completed = _v4_global(_v4_scope, "subprocess").run(argv, shell=False,
+            check=False, capture_output=True, text=True, timeout=180)
+        lines = str(completed.stdout or "").splitlines()
+        payload = json.loads(lines[-1]) if lines else {}
+    except Exception as error:
+        return {"status": "FAILED", "target_date": target,
+                "reason_code": _safe_failure_code(error)}
+    if not isinstance(payload, dict):
+        return {"status": "CANNOT_CONFIRM", "target_date": target,
+                "reason_code": "HK_DAILY_SUPPLEMENT_RESULT_INVALID"}
+    return {key: payload.get(key) for key in (
+        "status", "target_date", "through_date", "run_id", "manifest_relative",
+        "manifest_sha256", "raw_capture_sha256", "code_count", "record_status_counts",
+        "published_at", "reused", "volume_unit_status", "price_basis", "error",
+    ) if key in payload} | {"exit_code": int(completed.returncode),
+        "owner_path": str(original_owner)}
+
