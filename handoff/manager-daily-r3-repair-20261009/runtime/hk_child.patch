+def _read_exact_capture(_v4_scope, /, target, receipt_root, ensure_module):
+    root = Path(receipt_root).expanduser().resolve()
+    directory = root / "hk_capture" / target
+    if not directory.exists():
+        return None
+    if not _safe_directory(directory):
+        raise ValueError("HK_CAPTURE_DIRECTORY_UNSAFE")
+    manifests = sorted(directory.glob("*.json"), key=lambda path: path.stat().st_mtime_ns, reverse=True)
+    if len(manifests) > 2048:
+        raise ValueError("HK_CAPTURE_MANIFEST_BOUND_EXCEEDED")
+    valid = []
+    for path in manifests:
+        if not _safe_regular_file(path):
+            raise ValueError("HK_CAPTURE_MANIFEST_UNSAFE")
+        try:
+            raw_manifest = path.read_bytes()
+            envelope = json.loads(raw_manifest.decode("utf-8-sig"))
+        except (OSError, UnicodeError, json.JSONDecodeError) as error:
+            raise ValueError("HK_CAPTURE_MANIFEST_UNREADABLE") from error
+        if not isinstance(envelope, dict) or envelope.get("schema_version") != "v3.macos.research_panel_hk_capture_manifest.v1":
+            continue
+        if envelope.get("target_date") != target:
+            continue
+        if envelope.get("status") not in {"READY", "PENDING"}:
+            continue
+        capture = envelope.get("capture")
+        relative = envelope.get("capture_relative_path") or envelope.get("capture_path")
+        if (not isinstance(capture, dict) or not isinstance(relative, str)
+                or Path(relative).is_absolute() or ".." in Path(relative).parts):
+            raise ValueError("HK_CAPTURE_MANIFEST_CONTRACT_INVALID")
+        raw_path = path.parent / relative
+        if not _safe_regular_file(raw_path):
+            raise ValueError("HK_CAPTURE_RAW_MISSING")
+        try:
+            raw_path.resolve().relative_to(directory.resolve())
+        except ValueError as error:
+            raise ValueError("HK_CAPTURE_RAW_PATH_ESCAPE") from error
+        raw_capture = raw_path.read_bytes()
+        if (json.loads(raw_capture.decode("utf-8-sig")) != capture
+                or hashlib.sha256(raw_capture).hexdigest() != envelope.get("capture_raw_sha256")
+                or capture.get("capture_sha256") != envelope.get("capture_sha256")
+                or capture.get("capture_run_id") != envelope.get("capture_run_id")
+                or capture.get("quote_status") != envelope.get("quote_status")
+                or capture.get("membership_status") != "READY"
+                or capture.get("status") != "READY"
+                or capture.get("quote_status") not in {"READY", "FAILED"}):
+            raise ValueError("HK_CAPTURE_RAW_IDENTITY_INVALID")
+        ensure_module._validated_capture(capture, trade_date=target, panel_sha256=None)
+        _validate_capture_response_date(capture, target)
+        source = capture.get("source_payload")
+        if not isinstance(source, dict):
+            raise ValueError("HK_CAPTURE_SOURCE_PAYLOAD_INVALID")
+        rows = capture.get("rows")
+        collected = {
+            "status": "READY" if capture.get("quote_status") == "READY" else "PARTIAL",
+            "target_date": target, "rows": rows,
+            "universe_count": len(capture["codes"]), "row_count": len(rows),
+            "coverage_rate": len(rows) / max(len(capture["codes"]), 1),
+            "positive_volume_coverage_rate": source.get("positive_volume_coverage_rate"),
+            "positive_turnover_coverage_rate": source.get("positive_turnover_coverage_rate"),
+            "excluded_count": source.get("excluded_count"),
+            "excluded_codes": list(source.get("excluded_codes") or [])[:_v4_global(_v4_scope, "MAX_EXCLUDED_EVIDENCE")],
+            "excluded_reasons": source.get("excluded_reasons"),
+            "source_sha256": capture.get("source_sha256"), "sha256": capture.get("source_sha256"),
+            "capture_manifest_path": str(path), "capture_raw_path": str(raw_path),
+            "capture_raw_sha256": hashlib.sha256(raw_capture).hexdigest(),
+        }
+        valid.append((path.stat().st_mtime_ns, capture, collected, path, raw_path, raw_capture))
+    if not valid:
+        return None
+    _mtime, capture, collected, path, raw_path, raw_capture = max(valid, key=lambda value: value[0])
+    return {"capture": capture, "collected": collected, "manifest_path": path,
+            "raw_path": raw_path, "raw_bytes": raw_capture}
+
+
+def _safe_failure_code(error):
+    text = str(error)
+    if re.fullmatch(r"HK_[A-Z0-9_]{1,120}", text):
+        return text
+    return "HK_OWNER_FAILED_" + type(error).__name__.upper()[:64]
+
+
+def _validate_capture_response_date(capture, target):
+    responses = capture.get("plate_responses") if isinstance(capture, dict) else None
+    if not isinstance(responses, dict) or not responses:
+        raise ValueError("HK_CAPTURE_PLATE_RESPONSES_MISSING")
+    for response in responses.values():
+        if not isinstance(response, dict):
+            raise ValueError("HK_CAPTURE_PLATE_RESPONSE_INVALID")
+        try:
+            requested = datetime.fromisoformat(str(response.get("requested_at") or "").replace("Z", "+00:00"))
+            completed = datetime.fromisoformat(str(response.get("completed_at") or "").replace("Z", "+00:00"))
+        except (TypeError, ValueError) as error:
+            raise ValueError("HK_CAPTURE_RESPONSE_TIME_INVALID") from error
+        if (requested.tzinfo is None or completed.tzinfo is None
+                or completed.astimezone(ZoneInfo("Asia/Shanghai")).strftime("%Y%m%d") != target
+                or completed.astimezone(timezone.utc) < requested.astimezone(timezone.utc)):
+            raise ValueError("HK_CAPTURE_ACQUISITION_DATE_MISMATCH")
+
+
+def _compact_membership(value):
+    authority = value.get("universe_authority") if isinstance(value, dict) else None
+    if not isinstance(authority, dict):
+        return {"status": "CANNOT_CONFIRM"}
+    files = authority.get("written_files")
+    return {
+        "status": value.get("status"), "trade_date": value.get("trade_date"),
+        "row_count": value.get("row_count"), "capture_sha256": value.get("capture_sha256"),
+        "source_sha256": value.get("source_sha256"),
+        "authority_run_id": authority.get("run_id"),
+        "authority_capture_run_id": authority.get("capture_run_id"),
+        "authority_capture_sha256": authority.get("capture_sha256"),
+        "publication_relative": authority.get("publication_relative"),
+        "written_files": files if isinstance(files, dict) else {},
+    }
+
+
+def _write_sealed(safe, relative, value, *, require_absent=True):
+    sealed = _seal(value)
+    encoded = _canonical(sealed) + b"\n"
+    safe.write_bytes(relative, encoded, require_absent=require_absent)
+    raw = safe.read_bytes(relative, max_bytes=4 * 1024 * 1024)
+    if raw != encoded:
+        raise ValueError("HK_PUBLICATION_RECEIPT_READBACK_MISMATCH")
+    return {"path": relative, "sha256": hashlib.sha256(raw).hexdigest(), "bytes": len(raw)}
+
+
+def _artifact_refs(_v4_scope, target, args, store_root, result, capture, *,
+                   receipt_root, chain_id):
+    refs = []
+    seen = set()
+
+    def add(path, role, expected_sha256=None, expected_bytes=None):
+        ref = _file_ref(Path(path), role=role, expected_sha256=expected_sha256,
+                        expected_bytes=expected_bytes)
+        if ref["path"] not in seen:
+            refs.append(ref)
+            seen.add(ref["path"])
+
+    def add_pointer_snapshot(path, role, filename):
+        source = Path(path).expanduser().resolve()
+        if not _safe_regular_file(source):
+            raise ValueError("HK_PUBLICATION_POINTER_SOURCE_UNSAFE")
+        raw = source.read_bytes()
+        try:
+            pointer = json.loads(raw.decode("utf-8-sig"))
+        except (UnicodeError, json.JSONDecodeError) as error:
+            raise ValueError("HK_PUBLICATION_POINTER_SOURCE_INVALID") from error
+        if not isinstance(pointer, dict):
+            raise ValueError("HK_PUBLICATION_POINTER_SOURCE_INVALID")
+        relative = f"hk_publication/{target}/{chain_id}/snapshots/{filename}"
+        safe = _v4_global(_v4_scope, "SafeRoot")(receipt_root)
+        safe.ensure_directory(f"hk_publication/{target}/{chain_id}/snapshots")
+        safe.write_bytes(relative, raw, require_absent=True)
+        snapshot = Path(receipt_root).expanduser().resolve() / relative
+        ref = _file_ref(snapshot, role=role)
+        source_sha = hashlib.sha256(raw).hexdigest()
+        ref.update(source_path=str(source), source_sha256=source_sha,
+            source_bytes=len(raw), snapshot_kind="IMMUTABLE_POINTER_BYTES")
+        if source_sha != ref["sha256"] or len(raw) != ref["bytes"]:
+            raise ValueError("HK_PUBLICATION_POINTER_SNAPSHOT_READBACK_MISMATCH")
+        refs.append(ref)
+        seen.add(ref["path"])
+        return ref
+
+    manifest_path = result.get("capture_manifest_path")
+    raw_path = result.get("capture_raw_path")
+    if capture is not None and isinstance(manifest_path, str) and isinstance(raw_path, str):
+        add(manifest_path, "HK_SDK_CAPTURE_MANIFEST")
+        add(raw_path, "HK_SDK_CAPTURE_RAW", expected_sha256=result.get("capture_raw_sha256"))
+
+    membership = result.get("membership")
+    authority_v2 = membership.get("universe_authority") if isinstance(membership, dict) else None
+    if isinstance(authority_v2, dict):
+        root = Path(store_root).expanduser().resolve()
+        written = authority_v2.get("written_files")
+        if not isinstance(written, dict) or not written:
+            raise ValueError("HK_MEMBERSHIP_PUBLICATION_REFERENCES_MISSING")
+        for relative, metadata in sorted(written.items()):
+            if not isinstance(metadata, dict):
+                raise ValueError("HK_MEMBERSHIP_PUBLICATION_REFERENCE_INVALID")
+            candidate = (root / str(relative)).resolve()
+            try:
+                candidate.relative_to(root)
+            except ValueError as error:
+                raise ValueError("HK_MEMBERSHIP_PUBLICATION_PATH_INVALID") from error
+            add(candidate, "HK_CONNECT_V2_" + Path(str(relative)).suffix.lstrip(".").upper(),
+                expected_sha256=metadata.get("sha256"), expected_bytes=metadata.get("size_bytes"))
+        publication_rel = authority_v2.get("publication_relative")
+        if not isinstance(publication_rel, str):
+            raise ValueError("HK_MEMBERSHIP_PUBLICATION_RECEIPT_MISSING")
+        add(root / publication_rel, "HK_CONNECT_V2_PUBLICATION")
+
+    panel_authority = result.get("authority")
+    asset_root = Path(args.hk_asset_root).expanduser().resolve()
+    if not isinstance(panel_authority, dict) or not isinstance(panel_authority.get("manifest_relative"), str):
+        raise ValueError("HK_PANEL_AUTHORITY_REFERENCE_MISSING")
+    panel_manifest_path = (asset_root / panel_authority["manifest_relative"]).resolve()
+    panel_manifest_path.relative_to(asset_root)
+    panel_manifest = json.loads(panel_manifest_path.read_text(encoding="utf-8"))
+    panel_relative = panel_manifest.get("panel_relative")
+    if not isinstance(panel_relative, str):
+        raise ValueError("HK_PANEL_ARTIFACT_REFERENCE_MISSING")
+    panel_path = (asset_root / panel_relative).resolve()
+    panel_path.relative_to(asset_root)
+    add_pointer_snapshot(asset_root / "panel_latest.json", "HK_PANEL_LATEST_POINTER",
+        "panel_latest.snapshot.json")
+    add(panel_manifest_path, "HK_PANEL_MANIFEST")
+    add(panel_path, "HK_PANEL_PARQUET", expected_sha256=panel_authority.get("panel_sha256"))
+
+    master = result.get("security_master")
+    if not isinstance(master, dict):
+        raise ValueError("HK_SECURITY_MASTER_REFERENCE_MISSING")
+    master_root = Path(store_root).expanduser().resolve() / "assets" / "hk_security_master"
+    latest_path = master_root / "latest.json"
+    latest = json.loads(latest_path.read_text(encoding="utf-8"))
+    entry = latest.get("entries", {}).get(target)
+    if not isinstance(entry, dict):
+        raise ValueError("HK_SECURITY_MASTER_LATEST_ENTRY_MISSING")
+    master_manifest_path = (master_root / entry["manifest_relative"]).resolve()
+    master_manifest_path.relative_to(master_root.resolve())
+    master_manifest = json.loads(master_manifest_path.read_text(encoding="utf-8"))
+    add_pointer_snapshot(latest_path, "HK_SECURITY_MASTER_LATEST_POINTER",
+        "security_master_latest.snapshot.json")
+    add(master_manifest_path, "HK_SECURITY_MASTER_MANIFEST",
+        expected_sha256=master.get("security_master_manifest_sha256"))
+    add(master_root / master_manifest["artifact_relative"], "HK_SECURITY_MASTER_ARTIFACT",
+        expected_sha256=master.get("security_master_artifact_sha256"))
+    receipt_relative = entry.get("receipt_relative")
+    if not isinstance(receipt_relative, str):
+        raise ValueError("HK_SECURITY_MASTER_RECEIPT_MISSING")
+    add(master_root / receipt_relative, "HK_SECURITY_MASTER_RECEIPT")
+    return refs
+
