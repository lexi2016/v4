+            or terminal.get("schema_version") != CHAIN_SCHEMA
+            or terminal.get("status") != "READY" or terminal.get("target_date") != target
+            or terminal.get("chain_id") != pointer.get("chain_id")
+            or not re.fullmatch(r"[0-9a-f]{32}", str(terminal.get("capture_run_id") or ""))
+            or terminal.get("sha256") != _seal(terminal)["sha256"]
+            or any(terminal.get(key) is not False for key in
+                   ("production_allowed", "buy_gate_updated", "orders_sent"))):
+        raise ValueError("HK_PUBLICATION_CHAIN_TERMINAL_INVALID")
+    stages = terminal.get("stages")
+    if not isinstance(stages, list) or len(stages) != len(CHAIN_REQUIRED_STAGES):
+        raise ValueError("HK_PUBLICATION_CHAIN_STAGES_INVALID")
+    stage_names = []
+    stage_values = {}
+    for reference in stages:
+        if not isinstance(reference, dict):
+            raise ValueError("HK_PUBLICATION_CHAIN_STAGE_REFERENCE_INVALID")
+        relative = reference.get("path")
+        if (not isinstance(relative, str) or relative.startswith("/")
+                or ".." in Path(relative).parts or "\\" in relative):
+            raise ValueError("HK_PUBLICATION_CHAIN_STAGE_PATH_INVALID")
+        raw = safe.read_bytes(relative, max_bytes=2 * 1024 * 1024)
+        stage = json.loads(raw.decode("utf-8"))
+        if (len(raw) != reference.get("bytes")
+                or hashlib.sha256(raw).hexdigest() != reference.get("sha256")
+                or stage.get("schema_version") != CHAIN_SCHEMA
+                or stage.get("target_date") != target
+                or stage.get("chain_id") != terminal.get("chain_id")
+                or stage.get("capture_run_id") != terminal.get("capture_run_id")
+                or stage.get("status") != "READY"
+                or stage.get("stage") != reference.get("stage")
+                or stage.get("sha256") != _seal(stage)["sha256"]
+                or any(stage.get(key) is not False for key in
+                       ("production_allowed", "buy_gate_updated", "orders_sent"))):
+            raise ValueError("HK_PUBLICATION_CHAIN_STAGE_READBACK_INVALID")
+        stage_names.append(stage.get("stage"))
+        stage_values[stage.get("stage")] = stage
+    if tuple(stage_names) != CHAIN_REQUIRED_STAGES:
+        raise ValueError("HK_PUBLICATION_CHAIN_STAGE_ORDER_INVALID")
+    artifacts = terminal.get("artifact_refs")
+    if not isinstance(artifacts, list) or not artifacts or len(artifacts) > 4096:
+        raise ValueError("HK_PUBLICATION_CHAIN_ARTIFACT_REFERENCES_INVALID")
+    total_artifact_bytes = 0
+    for reference in artifacts:
+        if not isinstance(reference, dict):
+            raise ValueError("HK_PUBLICATION_CHAIN_ARTIFACT_REFERENCE_INVALID")
+        path = Path(str(reference.get("path") or "")).expanduser()
+        if (not path.is_absolute() or not _safe_regular_file(path)
+                or isinstance(reference.get("bytes"), bool)
+                or not isinstance(reference.get("bytes"), int)
+                or path.stat().st_size != reference.get("bytes")):
+            raise ValueError("HK_PUBLICATION_CHAIN_ARTIFACT_MISSING")
+        total_artifact_bytes += reference["bytes"]
+        if reference["bytes"] > 256 * 1024 * 1024 or total_artifact_bytes > 1024 * 1024 * 1024:
+            raise ValueError("HK_PUBLICATION_CHAIN_ARTIFACT_BUDGET_EXCEEDED")
+        if _sha256_path(path) != reference.get("sha256"):
+            raise ValueError("HK_PUBLICATION_CHAIN_ARTIFACT_SHA_MISMATCH")
+    chain_root = (root / Path(terminal_relative).parent).resolve()
+    pointer_snapshots = {
+        "HK_PANEL_LATEST_POINTER": ("panel_latest.snapshot.json", "panel_latest.json", "hk_0_2"),
+        "HK_SECURITY_MASTER_LATEST_POINTER": (
+            "security_master_latest.snapshot.json", "latest.json", "hk_security_master"),
+    }
+    for reference in artifacts:
+        spec = pointer_snapshots.get(reference.get("role"))
+        if spec is None or "source_path" not in reference:
+            continue  # Legacy, direct-path pointer refs remain readable until their bytes move.
+        snapshot_name, source_name, source_root_name = spec
+        path = Path(reference["path"]).resolve()
+        expected_snapshot = (chain_root / "snapshots" / snapshot_name).resolve()
+        source_path = Path(str(reference.get("source_path") or ""))
+        if (path != expected_snapshot or not source_path.is_absolute()
+                or source_path.name != source_name
+                or source_path.parent.name != source_root_name
+                or reference.get("snapshot_kind") != "IMMUTABLE_POINTER_BYTES"
+                or reference.get("source_sha256") != reference.get("sha256")
+                or reference.get("source_bytes") != reference.get("bytes")):
+            raise ValueError("HK_PUBLICATION_CHAIN_POINTER_SNAPSHOT_INVALID")
+    summary = terminal.get("lane_summary")
+    if (not isinstance(summary, dict) or summary.get("status") != "READY"
+            or summary.get("target_date") != target or summary.get("row_count", 0) < 1
+            or summary.get("coverage_rate", 0) <= 0):
+        raise ValueError("HK_PUBLICATION_CHAIN_LANE_SUMMARY_INVALID")
+    _verify_chain_artifact_contract(target, terminal, stage_values, artifacts, summary)
+    return {"terminal": terminal, "terminal_sha256": hashlib.sha256(terminal_raw).hexdigest(),
+            "terminal_relative": terminal_relative, "pointer": pointer, "lane_summary": summary}
+
