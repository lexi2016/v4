+      nullableSha(row.saved_sha256)&&nullableSha(row.current_sha256)&&row.saved_sha256!==row.current_sha256;})&&
+    new Set(rows.map(raw=>object(raw).component)).size===rows.length;
+  if(!verified)return '；本次输入身份差异：CANNOT_CONFIRM；缺少可与当前输入绑定的 component 证据，不能确定具体 changed field。';
+  return `；本次输入身份差异：${count} 项；${rows.slice(0,4).map(raw=>String(object(raw).component)).join('、')}。本次比较的来源 binding 与 SHA 见来源审计；不据此推定此前 live mismatch 的唯一原因。`;
