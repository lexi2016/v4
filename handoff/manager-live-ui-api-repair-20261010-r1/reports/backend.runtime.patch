+def _build_research_attention(date: str, **inputs: Any) -> dict:
+    """Keep raw attention decisions/provenance; compute its semantic identity.
+
+    The original pure projector owns its internal identity extensions. A
+    second pure call, only when verified provenance differs from semantics,
+    prevents those extensions from reintroducing the registry fingerprint.
+    This never calls a source reader or alters an owner validation result.
+    """
+    from .research_attention import build_research_attention
+    value = build_research_attention(date, **inputs)
+    semantic = semantic_inputs(inputs)
+    if semantic != inputs:
+        checkpoint()
+        semantic_value = build_research_attention(date, **semantic)
+        checkpoint()
+        value['input_identity'] = semantic_value['input_identity']
+    return value
+
