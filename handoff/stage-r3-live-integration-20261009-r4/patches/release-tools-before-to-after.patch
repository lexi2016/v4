+def static_inventory_record(inventory: Sequence[Mapping[str, Any]]) -> dict[str, Any]:
+    """Use full app-relative paths, including every generated static file."""
+    rows = [dict(row) for row in inventory if _is_static_path(row.get("path"))]
+    return {"entry_count": len(rows), "aggregate_sha256": inventory_digest(rows), "entries": rows}
