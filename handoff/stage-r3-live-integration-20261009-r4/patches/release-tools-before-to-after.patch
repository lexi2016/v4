+                    or entry[owner + "_mode"] != observed.get("mode")):
+                raise ValueError("API_RELEASE_STATIC_TREE_DELTA_PIN_MISMATCH")
+    if candidate_inventory is not None and proof["after"] != static_inventory_record(candidate_inventory):
+        raise ValueError("API_RELEASE_STATIC_TREE_AFTER_MISMATCH")
+    return proof
