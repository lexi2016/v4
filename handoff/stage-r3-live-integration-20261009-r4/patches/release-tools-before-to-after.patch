+def _validate_static_tree(
+    proof: object, *, base_inventory: Sequence[Mapping[str, Any]],
+    entries: Sequence[Mapping[str, Any]], candidate_inventory: Sequence[Mapping[str, Any]] | None = None,
+) -> dict[str, Any]:
+    if (not isinstance(proof, dict) or set(proof) != {"schema_version", "root", "before", "after"}
+            or proof["schema_version"] != STATIC_SCHEMA_VERSION or proof["root"] != STATIC_ROOT):
+        raise ValueError("API_RELEASE_STATIC_TREE_PROOF_REQUIRED")
+    for owner in ("before", "after"):
+        record = proof[owner]
+        if (not isinstance(record, dict) or set(record) != {"entry_count", "aggregate_sha256", "entries"}
+                or not isinstance(record["entries"], list)
+                or type(record["entry_count"]) is not int
+                or record["entry_count"] != len(record["entries"])
+                or not _is_sha(record["aggregate_sha256"])
+                or record["aggregate_sha256"] != inventory_digest(record["entries"])):
+            raise ValueError("API_RELEASE_STATIC_TREE_INVENTORY_INVALID")
+        paths = []
+        for row in record["entries"]:
+            if (not isinstance(row, dict) or set(row) != {"path", "kind", "sha256", "mode", "size"}
+                    or row["kind"] != "file" or not _is_sha(row["sha256"])
+                    or not _is_mode(row["mode"]) or type(row["size"]) is not int or row["size"] < 0
+                    or not _is_static_path(row["path"])):
+                raise ValueError("API_RELEASE_STATIC_TREE_REGULAR_FILES_REQUIRED")
+            paths.append(_normalise_relative(row["path"]))
+        if paths != sorted(set(paths)) or len({path.casefold() for path in paths}) != len(paths):
+            raise ValueError("API_RELEASE_STATIC_TREE_PATHS_INVALID")
+    if STATIC_ROOT + "/index.html" not in {row["path"] for row in proof["after"]["entries"]}:
+        raise ValueError("API_RELEASE_STATIC_TREE_INDEX_REQUIRED")
+    if proof["before"] != static_inventory_record(base_inventory):
+        raise ValueError("API_RELEASE_STATIC_TREE_BASE_MISMATCH")
+    before = {row["path"]: row for row in proof["before"]["entries"]}
+    after = {row["path"]: row for row in proof["after"]["entries"]}
+    changed = {path for path in set(before) | set(after) if before.get(path) != after.get(path)}
+    static_entries = [row for row in entries if _is_static_path(row["path"])]
+    if {row["path"] for row in static_entries} != changed:
+        raise ValueError("API_RELEASE_STATIC_TREE_DELTA_PATHS_NOT_EXACT")
+    for entry in static_entries:
