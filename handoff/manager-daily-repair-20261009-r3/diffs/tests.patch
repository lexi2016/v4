+        assert refused.json()["status"] == "CANNOT_CONFIRM"
+        assert refused.json()["reason"] == "WORKSPACE_PLAN_INPUTS_NOT_READY"
+        assert service.get_workspace_plan(CURRENT) == original
+        assert _stored_content(service) == initial
