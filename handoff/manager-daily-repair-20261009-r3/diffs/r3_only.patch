+            and reference.get('status') == 'CONSUMED'
+            and daily.get('run_id') == reference.get('run_id')
+            and re.fullmatch(r'[0-9a-f]{32}', str(daily.get('run_id') or ''))
+            and re.fullmatch(r'[0-9a-f]{64}', str(daily.get('input_identity') or ''))
