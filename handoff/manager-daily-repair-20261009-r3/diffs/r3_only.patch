+    for channel in channels:
+        if (not isinstance(channel, Mapping) or channel.get('target_trade_date') != date
+                or not re.fullmatch(r'[0-9a-f]{64}', str(channel.get('input_identity') or ''))):
+            continue
+        if channel.get('status') in {'READY', 'READY_EMPTY'}:
+            return []
+        if channel.get('status') == 'PARTIAL' and any(
+                isinstance(row, Mapping) and row.get('target_trade_date') == date
+                and row.get('reason') and row.get('source_refs')
+                for row in channel.get('rows', [])):
