+def validate_research_acquisition(value: Mapping[str, Any]) -> None:
+    """Optional forward-only receipt; legacy observation clocks are not aliases."""
+    proof = value.get("acquisition_provenance")
+    if not isinstance(proof, Mapping):
+        raise ValueError("research acquisition provenance missing")
+    if (proof.get("schema_version") != "v4.zsxq_summary_acquisition.v1"
+            or proof.get("owner") != "ops.run_zsxq_hourly_delta"
+            or proof.get("retrieval_basis") != "PAGINATED_CLI_COMPLETED"
+            or proof.get("availability_basis") != "DERIVED_SUMMARY_PERSISTED"
+            or not isinstance(proof.get("run_id"), str) or not proof["run_id"]
+            or proof.get("summary_path") != f"external_sources/zsxq_hourly/{proof['run_id']}/zsxq_summary.json"
+            or not re.fullmatch(r"research_module/runtime_outputs/zsxq_hourly/\d{8}/\d{4}/v35_zsxq_hourly_status_\d{8}_\d{4}\.json", str(proof.get("status_path") or ""))):
+        raise ValueError("research acquisition provenance invalid")
+    for field in ("summary_sha256", "status_sha256"):
+        if not _SHA256.fullmatch(str(proof.get(field) or "")):
+            raise ValueError("research acquisition source SHA invalid")
+    for field in ("retrieved_at", "available_at"):
+        _aware_timestamp(value.get(field), field)
+        if value[field] != proof.get(field):
+            raise ValueError("research acquisition clock binding invalid")
+    stamp = lambda raw: datetime.fromisoformat(raw.replace("Z", "+00:00"))
+    if stamp(value["retrieved_at"]) > stamp(value["available_at"]):
+        raise ValueError("research acquisition clock order invalid")
+    if value.get("published_at"):
+        _aware_timestamp(value["published_at"], "published_at")
+        if stamp(value["published_at"]) > stamp(value["retrieved_at"]):
+            raise ValueError("research acquisition precedes publication")
 
 
