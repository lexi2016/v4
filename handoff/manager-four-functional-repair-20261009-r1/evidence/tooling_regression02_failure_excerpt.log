    def check_target(event, value, dir_fd=None, *, open_fd_unknown=False):
        # The open audit event omits os.open's dir_fd. A relative open for
        # writing therefore cannot safely be interpreted against cwd. Other
        # mutation events expose dir_fd; reject relative targets when that
        # descriptor does not unambiguously mean cwd. Absolute fixture/output
        # paths remain supported. Unresolved descriptor-only targets fail closed.
        reason = None
        if isinstance(value, int):
            reason = "UNRESOLVED_DESCRIPTOR_WRITE_REJECTED"
            detail = {"descriptor": value}
        else:
            raw = os.fsdecode(value)
            detail = {"path": raw}
            if not Path(raw).is_absolute() and (open_fd_unknown or dir_fd not in (None, -1)):
                reason = "UNRESOLVED_RELATIVE_WRITE_REJECTED"
            elif protected(raw):
                reason = "PROTECTED_SOURCE_WRITE_ATTEMPT"
        if reason is not None:
            events.append({"event": event, "reason": reason, **detail})
