+def daily_automation_config(value: Any=None) -> dict[str,Any]:
+    config=dict(DAILY_AUTOMATION_DEFAULTS)
+    config['same_day_catchup_slots_local']=list(DAILY_CATCHUP_SLOTS_LOCAL)
+    if value is not None:
+        if not isinstance(value,dict) or set(value)-set(DAILY_AUTOMATION_DEFAULTS):
+            raise ValueError('DAILY_AUTOMATION_CONFIG_INVALID')
+        config.update(value)
+    if type(config['enabled']) is not bool or config['status']!='PROPOSAL_ONLY':
+        raise ValueError('DAILY_AUTOMATION_CONFIG_INVALID')
+    slots=config['same_day_catchup_slots_local']
+    if (not isinstance(slots,list) or tuple(slots)!=DAILY_CATCHUP_SLOTS_LOCAL
+            or any(not re.fullmatch(r'\d{2}:\d{2}',str(slot)) for slot in slots)):
+        raise ValueError('DAILY_AUTOMATION_SLOT_SEQUENCE_INVALID')
+    budget=config['us_mapping_budget_seconds']
+    if isinstance(budget,bool) or not isinstance(budget,(int,float)) or not 0<budget<=5:
+        raise ValueError('DAILY_AUTOMATION_US_BUDGET_INVALID')
+    attempts=config['max_attempts_per_target_date']
+    if isinstance(attempts,bool) or not isinstance(attempts,int) or not 1<=attempts<=len(slots):
+        raise ValueError('DAILY_AUTOMATION_ATTEMPT_LIMIT_INVALID')
+    return config
 
 
