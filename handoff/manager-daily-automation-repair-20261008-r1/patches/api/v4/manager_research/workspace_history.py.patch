+def _reader_revalidation(saved: Mapping[str, Any]) -> dict:
+    """Separate source-byte identity from a supported historical read contract.
+
+    A different source fingerprint never admits a plan by itself. Only a
+    contract named in the sealed saved product can enter cross-source replay;
+    the original owners, cutoff, PIT and complete frozen fields decide below.
+    No-fingerprint legacy plans retain their existing full-replay admission.
+    """
+    reader = saved.get('read_contract_sha256')
+    if reader is not None and (not isinstance(reader, str)
+                               or not re.fullmatch(r'[0-9a-f]{64}', reader)):
+        raise ValueError('HISTORY_READER_IDENTITY_INVALID')
+    saved_read = saved['workspace'].get('read_context')
+    if saved_read is not None and not isinstance(saved_read, Mapping):
+        raise ValueError('HISTORY_READ_CONTRACT_UNPROVEN')
+    saved_contract = saved_read.get('contract') if saved_read is not None else None
+    if saved_contract is not None and saved_contract != READ_CONTRACT:
+        raise ValueError('HISTORY_READ_CONTRACT_UNSUPPORTED')
+    current_reader = contract_identity()
+    changed = reader is not None and reader != current_reader
+    if changed and saved_contract != READ_CONTRACT:
+        raise ValueError('HISTORY_READ_CONTRACT_UNPROVEN')
+    return dict(status='REVALIDATION_REQUIRED',
+        mode=('LEGACY_FULL_REVALIDATION' if reader is None else
+              'SAME_CONTRACT_SOURCE_CHANGE' if changed else 'IDENTICAL_SOURCE'),
+        saved_contract=saved_contract, current_contract=READ_CONTRACT,
+        saved_read_contract_sha256=reader, current_read_contract_sha256=current_reader,
+        method='ORIGINAL_OWNERS_EXACT_CUTOFF_FULL_REPLAY',
+        source_stable_during_revalidation=None, saved_plan_modified=False)
+
