+    assert value["daily_automation"]["enabled"] is True
+    assert value["daily_automation"]["same_day_catchup_slots_local"] == [
+        "10:00", "12:30", "15:45", "18:30", "22:30"]
+    assert value["daily_automation"]["status"] == "PROPOSAL_ONLY"
