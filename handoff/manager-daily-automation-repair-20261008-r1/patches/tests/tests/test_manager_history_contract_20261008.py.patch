+def test_late_execution_context_is_not_admitted_as_historical_preopen(service, monkeypatch):
+    early = _save(service, monkeypatch, '20260930', kind='SCHEDULED_PREOPEN')
+    late = deepcopy(early)
+    late['run_id'] = 'f' * 32
+    late['generated_at'] = '2026-09-30T09:28:00+08:00'
+    late['execution_kind'] = 'MANUAL_REFRESH'
+    late['execution_context'] = {
+        'trigger_kind': 'SCHEDULED', 'timing': 'LATE_CATCHUP',
+        'scheduled_for': '2026-09-30T10:00:00+08:00',
+        'started_at': '2026-09-30T10:00:00+08:00',
+        'finished_at': '2026-09-30T10:01:00+08:00',
+        'natural_run_verified': False,
+    }
+    late['sha256'] = w.digest({key:value for key,value in late.items() if key != 'sha256'})
+    service.store._write_atomic(service.store.root/'workspace_plans'/'20260930'/'latest.json', late)
+    service.store._write_atomic(service.store.root/'workspace_plans'/'20260930'/(late['run_id']+'.json'), late)
+    selected = h.select_plan(service.store, '20260930', h.boundary_context('20260930'))
+    assert selected is not None
+    assert selected['run_id'] == early['run_id']
+
+
+def test_late_only_plan_is_not_materialized_for_history(service, monkeypatch):
+    late = _save(service, monkeypatch, '20260930')
+    old_run_path = service.store.root/'workspace_plans'/'20260930'/(late['run_id']+'.json')
+    late['run_id'] = 'f' * 32
+    late['execution_context'] = {
+        'trigger_kind': 'SCHEDULED', 'timing': 'LATE_CATCHUP',
+        'scheduled_for': '2026-09-30T10:00:00+08:00',
+        'started_at': '2026-09-30T10:00:00+08:00',
+        'finished_at': '2026-09-30T10:01:00+08:00',
+        'natural_run_verified': False,
+    }
+    late['generated_at'] = '2026-09-30T09:28:00+08:00'
+    late['sha256'] = w.digest({key:value for key,value in late.items() if key != 'sha256'})
+    service.store._write_atomic(service.store.root/'workspace_plans'/'20260930'/'latest.json', late)
+    service.store._write_atomic(service.store.root/'workspace_plans'/'20260930'/(late['run_id']+'.json'), late)
+    old_run_path.unlink()
+    assert h.select_plan(service.store, '20260930', h.boundary_context('20260930')) is None
+
