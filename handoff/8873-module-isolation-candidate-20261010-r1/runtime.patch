+        entries.append({"path": relative, "before_sha256": sha256_bytes(before_raw) if before_raw is not None else None,
+            "after_sha256": sha256_bytes(after_raw) if after_raw is not None else None,
+            "unified_diff_sha256": proof, "unified_diff_hunk_count": count,
+            "before_mode": current_inventory.get(relative, {}).get("mode"),
+            "after_mode": parent_inventory.get(relative, {}).get("mode")})
