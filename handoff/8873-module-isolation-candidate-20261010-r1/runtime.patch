+def assert_business_output_boundary(output_root: Path, active: Mapping[str, Any]) -> None:
+    """Protect every retained release and externally bound input from output.
+
+    Missing or corrupt retained lineage is not permission to write there.
+    It must be repaired/rebound separately before another business build.
+    """
+    output = Path(os.path.abspath(output_root))
+    protected = [Path(active["api_plist_path"]).parent]
+    contract, _, _ = _business.read_owner_contract(active, _api=sys.modules[__name__])
+    protected.extend(Path(path) for path in contract["protected_external_roots"])
+    identity, seen = active, set()
+    while True:
+        root = Path(identity["release_root"])
+        if root in seen or len(seen) >= 4096:
+            raise ValueError("API_BUSINESS_RETAINED_LINEAGE_INVALID")
+        seen.add(root)
+        protected.append(root)
+        details = identity["manifest"].get("api_integration")
+        if details is None:
+            break
+        if not isinstance(details, Mapping) or not isinstance(details.get("base"), Mapping):
+            raise ValueError("API_BUSINESS_RETAINED_LINEAGE_INVALID")
+        identity = _identity_from_base_record(details["base"])
+    payload = plistlib.loads(Path(active["api_plist_path"]).read_bytes())
+    environment = list((payload.get("EnvironmentVariables") or {}).items())
+    for item in payload.get("ProgramArguments", []):
+        if isinstance(item, str) and "=" in item:
+            key, value = item.split("=", 1)
+            environment.append((key, value))
+    for key, value in environment:
+        path_binding = key.endswith(("_ROOT", "_PATH", "_FILE"))
+        if path_binding and value and (not isinstance(value, str) or not Path(value).is_absolute()):
+            raise ValueError("API_BUSINESS_PATH_BINDING_UNCONFIRMED:" + key)
+        if isinstance(value, str) and Path(value).is_absolute():
+            protected.append(Path(value).resolve())
+    authority = active.get("identity_from_plist", {}).get(_business.AUTHORITY_PATH_KEY)
+    if authority:
+        protected.append(Path(authority).resolve())
+    if any(output == root or output.is_relative_to(root) or root.is_relative_to(output) for root in protected):
+        raise ValueError("API_BUSINESS_OUTPUT_BOUNDARY")
