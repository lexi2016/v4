+def _market_screen_identity_projection(screen: Mapping[str, Any] | None) -> Mapping[str, Any] | None:
+    """Keep the visible screen cutoff out of identity unless it changes a result.
+
+    The cutoff still controls the screen's source reads and eligibility before
+    this projection is built. Only the raw read-clock leaf is omitted; every
+    source identity, decision, gap, result, and phase remains part of identity.
+    """
+    if not isinstance(screen, Mapping):
+        return screen
+    value = deepcopy(dict(screen))
+    data_context = value.get('data_context')
+    if isinstance(data_context, Mapping):
+        identity_context = dict(data_context)
+        identity_context.pop('research_cutoff', None)
+        value['data_context'] = identity_context
+    return value
 
 
