+class _IntakeBodyEvidenceParser(_ArticleBodyTextParser):
+    """Use the shared js_content parser and retain ordered image source URLs."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.body_image_urls: list[str] = []
+
+    def on_image(self, attrs: list[tuple[str, str | None]]) -> None:
+        attributes = {str(key).lower(): str(value or "").strip() for key, value in attrs}
+        source = attributes.get("data-src") or attributes.get("src")
+        if source:
+            self.body_image_urls.append(source)
