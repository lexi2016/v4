+def _source_image_url(value: object) -> str:
+    raw = str(value or "").strip()
+    if raw.startswith("//"):
+        return "https:" + raw
+    parsed = urlsplit(raw)
+    if parsed.scheme.lower() in {"http", "https"} and parsed.hostname:
+        return parsed._replace(scheme="https", netloc=parsed.netloc.lower(), fragment="").geturl()
+    return raw
+
