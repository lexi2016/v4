+def _validate_article_body(html_bytes: bytes, manifest_rows: list[dict[str, str]]) -> None:
+    """Reject summary-only BODY claims; allow real text or matched image-only BODY."""
+    try:
+        parser = _IntakeBodyEvidenceParser()
+        parser.feed(html_bytes.decode("utf-8-sig", errors="replace"))
+        parser.close()
+    except (TypeError, ValueError) as exc:
+        raise ValueError("raw article HTML cannot be parsed") from exc
+    if not parser._found_root:
+        raise ValueError("raw article HTML has no js_content BODY block")
+    if parser.text().strip():
+        return
+    observed = [_source_image_url(value) for value in parser.body_image_urls]
+    expected = [_source_image_url(row.get("url")) for row in manifest_rows]
+    if not expected or observed != expected:
+        raise ValueError("empty-text BODY has no ordered js_content images matching the image manifest")
+
