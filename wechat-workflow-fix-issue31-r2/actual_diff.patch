+        if token == "--out":
+            if index + 1 >= len(output):
+                raise ValueError("--out requires a value")
+            output[index + 1] = str(stage_dir)
+            replaced = True
+            index += 2
+            continue
+        if token.startswith("--out="):
+            output[index] = f"--out={stage_dir}"
+            replaced = True
