+    @classmethod
+    def _map_input_contexts(cls, body: dict[str, Any],
+                            convert: Callable[[Any], Any]) -> dict[str, Any]:
+        context = cls._map_overlay_fields(body.get("context"), convert)
+        batches = body.get("batches")
+        if not isinstance(batches, list):
