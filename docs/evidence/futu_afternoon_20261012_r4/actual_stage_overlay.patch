+    trade_date: str,
+    stage_id: str,
+    market: str,
+    source_id: str,
+    source_status: str,
+    rows: Sequence[Mapping[str, Any]],
+    requested_rows: int | None,
+    missing_symbols: Sequence[str],
+    cannot_confirm: Sequence[str],
