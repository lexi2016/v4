+    cannot_confirm: Sequence[str],
+    source_evidence: Sequence[str],
+    window: str | None,
+    cutoff_at: str | None,
+):
+    context = {
+        "enabled": research_observation_contract == HK_FUTU_RTDATA_OBSERVATION_CONTRACT,
+        "trade_date": trade_date,
+        "stage_id": stage_id,
+        "market": market,
+        "source_id": source_id,
+        "source_status": source_status,
+        "rows": rows,
