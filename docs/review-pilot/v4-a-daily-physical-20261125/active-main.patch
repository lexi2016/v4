new file mode 100644
--- /dev/null
+++ b/ops/research_a_daily_physical.py
@@ -0,0 +1,152 @@
+"""Physical-space guard and publication for the scheduled A-only chain."""
+from contextlib import contextmanager
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+
+from ops.macos_research_panel_daily_common import SnapshotGateError
+
+MIN_FREE_BYTES = 30 * 1024**3
+MODE_ENV = "V4_A_DAILY_PHYSICAL_STORAGE"
+_POLICY_ENV = ("V4_RESEARCH_RETENTION_POLICY", "V4_RESEARCH_RETENTION_POLICY_SHA256")
+_ROOT_ENVS = (
+    "V4_RESEARCH_PANEL_A_TDX_ROOT",
+    "V4_RESEARCH_PANEL_RECEIPT_ROOT",
+    "V4_RESEARCH_PANEL_A_DATA_ROOT",
+    "V4_RESEARCH_PANEL_A_RETURN_ROOT",
+    "V4_A_SHARE_DAILY_PRODUCT_ROOT",
+    "V4_WORKBENCH_CLASSIFICATION_ROOT",
+    "V4_WORKBENCH_STATISTICS_ROOT",
+    "V4_STORAGE_PAIR_ROOT",
+)
+
+
+def require_space(*roots):
+    for root in dict.fromkeys(root for root in roots if root):
+        path = Path(root).resolve()
+        while not path.exists():
+            path = path.parent
+        free = shutil.disk_usage(path).free
+        if free < MIN_FREE_BYTES:
+            raise SnapshotGateError(
+                f"A_DAILY_PHYSICAL_SPACE_MINIMUM:free={free}:required={MIN_FREE_BYTES}:path={path}"
+            )
+
+
+def require_configured_space():
+    require_space(*(os.environ.get(key) for key in _ROOT_ENVS))
+
+
+@contextmanager
+def scheduled_storage():
+    # The slot dispatcher runs workloads synchronously in its own process.
+    # Restore both bindings before the next workload in the same slot.
+    previous = {key: os.environ.pop(key, None) for key in (*_POLICY_ENV, MODE_ENV)}
+    os.environ[MODE_ENV] = "1"
+    try:
+        yield
+    finally:
+        for key, value in previous.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
+                os.environ[key] = value
+
+
+def physical_mode():
+    if os.environ.get(MODE_ENV) != "1":
+        return False
+    if any(key in os.environ for key in _POLICY_ENV):
+        raise SnapshotGateError("A_DAILY_PHYSICAL_STORAGE_POLICY_CONFLICT")
+    return True
+
+
+def publish_current_pair(data_root, target, result):
+    from ops.research_panel_qfq import panel_contract, publication_lock
+    from ops.research_storage_pair import publish_configured, settings
+
+    if result["status"] != "READY" or result["target_date"] != target:
+        raise SnapshotGateError("A_DAILY_QFQ_RESULT_DATE_OR_STATUS_CONFLICT")
+    if settings(data_root) is None:
+        raise SnapshotGateError("A_DAILY_PAIR_CONFIGURATION_MISSING")
+    paths = {role: Path(result[role]) for role in ("selector", "backtest")}
+    authority = result["authority"]
+    require_configured_space()
+    with publication_lock(data_root):
+        for path in paths.values():
+            contract = panel_contract(path)
+            if (contract.get("asof_date") != target
+                    or contract.get("generation_id") != authority["generation_id"]
+                    or contract.get("input_sha256") != authority["source_sha256"]):
+                raise SnapshotGateError("A_DAILY_QFQ_PAIR_IDENTITY_CONFLICT")
+        manifest = publish_configured(paths)
+        return pair_reference(data_root, target, authority, paths, expected_id=manifest["id"])
+
+
+def pair_reference(data_root, target, authority, paths, expected_id=None):
+    from ops.research_storage_pair import SCHEMA, canonical, safe_path, settings
+
+    configured = settings(data_root)
+    if configured is None:
+        raise SnapshotGateError("A_DAILY_PAIR_CONFIGURATION_MISSING")
+    root, _ = configured
+    current_path = safe_path(root / "current.json")
+    current_bytes = current_path.read_bytes()
+    current = json.loads(current_bytes)["current"]
+    pair_id = current["id"]
+    if (not isinstance(pair_id, str) or len(pair_id) != 64
+            or any(ch not in "0123456789abcdef" for ch in pair_id)
+            or (expected_id is not None and pair_id != expected_id)):
+        raise SnapshotGateError("A_DAILY_PAIR_CURRENT_IDENTITY_CONFLICT")
+    manifest_path = safe_path(root / "generations" / (pair_id + ".json"))
+    raw = manifest_path.read_bytes()
+    digest = hashlib.sha256(raw).hexdigest()
+    manifest = json.loads(raw)
+    identity = manifest["identity"]
+    if (current["path"] != str(manifest_path) or current["sha256"] != digest
+            or manifest["schema"] != SCHEMA or manifest.pop("id") != pair_id
+            or canonical(manifest) != pair_id
+            or identity.get("asof_date") != target
+            or identity.get("generation_id") != authority["generation_id"]
+            or identity.get("input_sha256") != authority["source_sha256"]
+            or {role: item["path"] for role, item in manifest["roles"].items()}
+               != {role: str(path) for role, path in paths.items()}
+            or current_path.read_bytes() != current_bytes):
+        raise SnapshotGateError("A_DAILY_PAIR_CURRENT_BINDING_CONFLICT")
+    return {"id": pair_id, "path": str(manifest_path), "sha256": digest}
+
+
+def ready_receipts(return_root, run_dir, generation, target, input_sha, paths):
+    """Read the two existing QFQ owner receipts on the exact generation."""
+    from ops.qfq_directory_contract import validate_qfq_generation_directory
+
+    root, directory = validate_qfq_generation_directory(str(return_root), run_dir, generation)
+    refs = {}
+    for name, filename, status in (
+        ("candidate_receipt", "candidate_receipt.json", "CANDIDATE_READY"),
+        ("ready_receipt", "stage_status.json", "READY"),
+    ):
+        path = directory / filename
+        before = path.lstat()
+        if path.is_symlink() or not path.is_file() or before.st_size > 8 * 1024**2:
+            raise SnapshotGateError("A_DAILY_QFQ_RECEIPT_PATH_INVALID")
+        raw = path.read_bytes()
+        after = path.lstat()
+        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
+            after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns
+        ):
+            raise SnapshotGateError("A_DAILY_QFQ_RECEIPT_CHANGED")
+        receipt = json.loads(raw)
+        if (receipt.get("status") != status or receipt.get("target_date") != target
+                or receipt.get("run_dir") != str(directory)
+                or receipt.get("generation_id") != generation
+                or receipt.get("input_sha256") != input_sha
+                or receipt.get("candidates") != paths
+                or (status == "READY" and any(receipt.get(role) != value
+                    or receipt.get(role + "_pointer_ready") is not True
+                    for role, value in paths.items()))):
+            raise SnapshotGateError("A_DAILY_QFQ_RECEIPT_IDENTITY_CONFLICT")
+        refs[name] = {"path": str(path), "sha256": hashlib.sha256(raw).hexdigest()}
+    return {"return_root": str(root), "run_dir": str(directory), **refs}
