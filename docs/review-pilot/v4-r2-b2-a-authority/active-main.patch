+                        or row.get("alias_skip") is not True or row.get("replacement_target_in_scope") is not True
+                        or row.get("alias_asset_sha256") != owner.BSE_ALIAS_ASSET_SHA256
+                        or row.get("alias_review_sha256") != owner.BSE_ALIAS_REVIEW_SHA256):
