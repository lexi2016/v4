+                        and row.get("replacement_ts_code") == fact["new_ts_code"]
+                        and alias_index[1].get(fact["new_code"]) == (2,)
+                        and fact["new_code"] in settled_bj):
+                    known_aliases[key] = fact["new_ts_code"]
+
+    excluded = []
+    unresolved = []
+    for key, row in sorted(open_rows.items()):
+        descriptor = {"symbol": key[0], "market": key[1], "path": key[2], "reason_code": row.get("reason_code")}
+        if key in known_delistings or key in known_aliases:
+            if key in known_aliases:
+                descriptor["replacement_ts_code"] = known_aliases[key]
+            excluded.append(descriptor)
+        else:
+            unresolved.append(descriptor)
+    nominal = len(keyed_rows)
+    accepted = nominal - len(open_rows)
+    eligible = nominal - len(excluded)
+    return {
+        "eligible_target_count": eligible,
+        "eligible_coverage_rate": accepted / eligible if eligible else None,
+        "nominal_coverage_rate": accepted / nominal if nominal else None,
+        "verified_obsolete_count": len(excluded),
+        "unresolved_eligible_count": len(unresolved),
+        "verified_obsolete": excluded,
+        "unresolved_eligible": unresolved,
+    }
