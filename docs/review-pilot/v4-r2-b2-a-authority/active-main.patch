+            if dispositions[key] == "QUARANTINED" and identities[key[:2]] == 1
+            and row.get("status") == "CANNOT_CONFIRM"
+            and row.get("quarantine") is True and row.get("target_date_ready") is False
+        }
+        if any(row.get("reason_code") == lifecycle_reason for row in candidates.values()):
+            lifecycle_facts = owner._load_verified_lifecycle_facts()
+            for key, row in candidates.items():
