+def _assert_no_unaccepted_current_native_bar(
+    target: int,
+    keyed_rows: Mapping[tuple[str, int, str], Mapping[str, Any]],
+    *,
+    classify: Any,
+) -> None:
+    """Guard QFQ's original root, where even an embedded date can be read."""
+    date_record = struct.Struct(f"<I{A_DAY_STRUCT.size - 4}x")
+    read_size = 4096 * date_record.size
+    identity_fields = ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns")
+
+    for key, row in keyed_rows.items():
+        if classify(row) == "ACCEPTED":
+            continue
+        path = Path(key[2])
+        digest = hashlib.sha256()
+        current_day = None
+        try:
+            with path.open("rb") as handle:
+                before = os.fstat(handle.fileno())
+                for block in iter(lambda: handle.read(read_size), b""):
+                    digest.update(block)
+                    # A non-record-aligned source already fails the original reader.
+                    if current_day is None and before.st_size % date_record.size == 0:
+                        current_day = next((day for (day,) in date_record.iter_unpack(block) if day >= target), None)
+            after = path.lstat()
+        except (OSError, ValueError, struct.error) as error:
+            raise SnapshotGateError(f"A sync unaccepted native date slots could not be checked: {path}") from error
+        if (digest.hexdigest() != _source_sha(row)
+                or any(getattr(before, field) != getattr(after, field) for field in identity_fields)):
+            raise SnapshotGateError(f"A sync unaccepted native source identity changed: {path}")
+        if current_day is not None:
+            raise SnapshotGateError(f"A sync original QFQ root has an unaccepted current or future native bar: {path}:{current_day}")
+
