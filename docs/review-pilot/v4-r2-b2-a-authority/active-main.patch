+                        and {k: v for k, v in reported_fact.items() if k != "source_policy_ref"}
+                        == {k: v for k, v in fact.items() if k != "source_policy_ref"}):
+                    known_delistings.add(key)
+        if any(row.get("reason_code") == alias_reason for row in candidates.values()):
+            alias_facts = owner._load_verified_bse_alias_facts()
+            alias_index = owner._bse_alias_scope_index(alias_facts, (key[:2] for key in keyed_rows))
+            settled_bj = {
+                key[0] for key in keyed_rows
+                if key[1] == 2 and (dispositions[key] == "ACCEPTED" or key in known_delistings)
+            }
+            for key, row in candidates.items():
