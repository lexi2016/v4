    "deduplication": "One member per unique normalized US symbol in each HK target + bucket. Preserve all adopted relation_ids for that member; duplicates do not add weight.",
    "direction_state": {
      "mean_sign": "Compute sign of the observed US source mean with no magnitude threshold; separately record mixed member signs. This is source-market observation only.",
      "multiple_valid_symbols": "PEER_BASKET",
