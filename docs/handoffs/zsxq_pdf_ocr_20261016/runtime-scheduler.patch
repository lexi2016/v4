+def _zsxq_pdf_post_success(self: Any, request: DispatchRequest, result: dict[str, Any]) -> dict[str, Any]:
+    """Attach bounded PDF progress after the existing research chain succeeds."""
+    if result.get("status") != "SUCCEEDED":
+        return result
+    date = str(request.business_date)
+    slot = str(request.slot)
+    status_relative = (
+        f"research_module/runtime_outputs/zsxq_hourly/{date}/{slot}/"
+        f"v35_zsxq_hourly_status_{date}_{slot}.json"
+    )
+    try:
+        status_path = resolve_owned_path(self.data_root, status_relative)
+        source_status = json.loads(status_path.read_text(encoding="utf-8"))
+        source_run_id = str(source_status.get("latest_run_id") or "")
+        if (
+            source_status.get("trade_date") != date
+            or str(source_status.get("slot")) != slot
+            or source_status.get("fetch_ok") is not True
+            or source_status.get("status") not in {"READY", "READY_EMPTY"}
+            or not source_run_id
+        ):
+            raise ValueError("ZSXQ_SOURCE_STATUS_NOT_READY")
+        pdf_result = self._run(
+            "ops.run_zsxq_hourly_delta",
+            [
+                "--data-root", str(self.data_root),
+                "--date", date,
+                "--slot", slot,
+                "--source-run-id", source_run_id,
+                "--pdf-only",
+                "--pdf-limit", "1",
+                "--pdf-time-budget-seconds", "180",
+            ],
+            timeout_seconds=290,
+        )
+        try:
+            payload = json.loads(str(pdf_result.get("stdout") or ""))
+        except (json.JSONDecodeError, TypeError):
+            payload = {}
+        if not isinstance(payload, dict):
+            payload = {}
+        result["pdf_ingestion"] = {
+            "schema_version": payload.get("schema_version", "v4.zsxq_pdf_continuation.v1"),
+            "status": payload.get("status", "CANNOT_CONFIRM"),
+            "runner_status": pdf_result.get("status"),
+            "error_code": payload.get("error_code"),
+            "processed_document_count": payload.get("processed_document_count", 0),
+            "done_total": payload.get("done_total", 0),
+            "partial_total": payload.get("partial_total", 0),
+            "failed_total": payload.get("failed_total", 0),
+            "pending_total": payload.get("pending_total", 0),
+            "time_budget_seconds": 180,
+            "max_documents": 1,
+            "late_processing": True,
+            "pit_status": "NON_PIT_CURRENT_KNOWLEDGE_SUPPLEMENT",
+            "production_allowed": False,
+            "buy_gate_updated": False,
+            "orders_sent": False,
+        }
+    except Exception as error:
+        result["pdf_ingestion"] = {
+            "schema_version": "v4.zsxq_pdf_continuation.v1",
+            "status": "CANNOT_CONFIRM",
+            "error_code": f"PDF_POST_SUCCESS_FAILED:{type(error).__name__}",
+            "processed_document_count": 0,
+            "done_total": 0,
+            "partial_total": 0,
+            "failed_total": 0,
+            "pending_total": 0,
+            "time_budget_seconds": 180,
+            "max_documents": 1,
+            "late_processing": True,
+            "pit_status": "NON_PIT_CURRENT_KNOWLEDGE_SUPPLEMENT",
+            "production_allowed": False,
+            "buy_gate_updated": False,
+            "orders_sent": False,
+        }
+    return result
 
 
