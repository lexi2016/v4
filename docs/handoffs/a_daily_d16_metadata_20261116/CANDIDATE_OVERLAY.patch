+def _official_admission_inputs(summary: dict, config_ref: dict, target: int):
+    """Use the immutable sync receipt already bound by the research cache plan."""
+    from ops._a_share_daily_sync_parts.official_daily_package import OfficialDailyPackage, SOURCE_KIND
+    from ops.research_panel_factor_cache import _sync_prequery_rows
+
+    try:
+        config = json.loads(_source(config_ref, owner="daily admission cache config").read_text())
+        sync_ref = config["prequery_sync_ref"]
+        frozen = json.loads(_source(sync_ref, owner="daily admission original sync").read_text())
+        if frozen != summary or frozen.get("dry_run") is not False:
+            return None
+        official = frozen["official_daily_source"]
+        if not isinstance(official, dict) or official.get("source_kind") != SOURCE_KIND:
+            return None
+        package = OfficialDailyPackage(official["input_ref"], target)
+        if (official["package"] != package.package_ref or official["members"] != package.summary["members"]
+                or official["previous_session"] != package.previous):
+            return None
+        return _sync_prequery_rows(sync_ref, target), package, [sync_ref, package.input_ref, package.package_ref, config_ref]
+    except (OSError, KeyError, TypeError, ValueError, QfqGateError, zipfile.BadZipFile):
+        return None
+
+
+def _official_symbol_admission(code, binding, history_end, target, admission_inputs, factor_refs):
+    if admission_inputs is None or history_end != target or not factor_refs:
+        return {}
+    sync_rows, package, common_refs = admission_inputs
+    row = sync_rows.get(code, {})
+    native = binding["raw_files"][-1]
+    if (row.get("classification") != "ACCEPTED" or row.get("quarantine") is not False
+            or row.get("target_date_ready") is not True or row.get("last_date_after") != target
+            or row.get("path") != native["path"] or row.get("source_sha256_after") != native["sha256"]):
+        return {}
+    lineage = row.get("source_lineage")
+    expected = package.lineage(row["market"], code[:6])
+    # An accepted row may carry earlier recovery siblings. Bind the current
+    # official record and refs without altering the accepted recovery history.
+    identity_keys = ("source_kind", "source_url", "package", "input_ref", "calendar",
+                     "calendar_adapter", "previous_session", "record", "target_date", "market", "code")
+    if (not isinstance(lineage, dict) or expected["record"] is None or row.get("source_kind") != expected["source_kind"]
+            or any(lineage.get(key) != expected[key] for key in identity_keys)):
+        return {}
+    evidence = {ref["path"]: ref for ref in [*common_refs, *factor_refs]}
+    return dict(history_end_date=history_end, accepted_evidence=list(evidence.values()))
 
 
