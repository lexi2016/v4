+                f"futu_capture_sha256={capture_sha256}",
+                f"futu_capture_path={capture_path}",
+            ),
+        )
+
+    binding = getattr(plan, "universe_bindings", {}).get("HK_CONNECT")
+    d1_provenance = _hk_morning_cached_d1_provenance(binding, requested)
