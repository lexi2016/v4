  "goal_scope": "r8-based manager-workbench saved-date dropdown plus prior US_MAPPING research-candidate count label; no production API, business-state, scheduler, or service mutation",
  "change_categories": [
    {
      "id": "date_dropdown_added",
      "behavior": "Replace the old free-form date calendar with one dropdown sourced lazily from read-only GET /api/v1/runs/date-list. Options are valid distinct sorted YYYYMMDD values displayed as YYYY-MM-DD, including the current target. Selection keeps compact YYYYMMDD route/API dates and clears old phase/run/paging state."
    },
    {
      "id": "prior_candidate_count_label_continued",
      "behavior": "Transplant the previously accepted usMappingCandidateCountLabel computed value and its existing muted paragraph. It reports candidate row count only when catalog_candidates is present; otherwise it says unknown. All candidate table rows remain rendered without truncation or filtering."
    }
  ],
