+def bind_completed_source_provenance(context,root):
+    """Revalidate the completed product's original proof after an app move.
+
+    SourceContext keeps its strict general identity checks. Only this completed
+    same-date/generation continuation may reuse the product's original, fully
+    checked transport proof instead of a byte-identical copy in a new app root.
+    """
+    from ops.research_panel_reader_compat import semantic_reader_identity
+    index=load(reference(Path(root)/'index.json'));day=str(context.target)
+    manifest_ref=index['dates'][day];manifest=load(manifest_ref);product=load(manifest['artifact'])
+    accepted=product.get('source_identity')or{}
+    if (product.get('data_date')!=day or manifest.get('data_date')!=day
+        or product.get('source_generation')!=context.generation
+        or manifest.get('source_generation')!=context.generation
+        or product.get('source_config')!=context.config_ref
+        or any(product.get(k)!=v for k,v in FLAGS.items())):
+        raise ValueError('COMPLETED_SOURCE_PRODUCT_CONFLICT')
+    context.unchanged()
+    if accepted==context.identity:
+        return dict(status='EXACT_COMPLETED_SOURCE',numeric_manifest=manifest_ref)
+    def core(identity):return {k:v for k,v in identity.items()if k!='reader_provenance'}
+    if core(accepted)!=core(context.identity):raise ValueError('COMPLETED_SOURCE_CORE_IDENTITY_DRIFT')
+    previous=context.identity.get('reader_provenance')or{}
+    expected=accepted.get('reader_provenance')or{}
+    if (previous.get('actual_reader')!=context.reader_ref
+        or expected.get('actual_reader')!=context.reader_ref):
+        raise ValueError('COMPLETED_SOURCE_ACTUAL_READER_DRIFT')
+    proof_ref=(expected.get('transport_equivalence')or{}).get('equivalence_proof')
+    if not isinstance(proof_ref,dict):raise ValueError('COMPLETED_SOURCE_ORIGINAL_PROOF_MISSING')
+    mathematical,proof=semantic_reader_identity(context.reader_ref,context.config_ref,
+        proof_path=checked(proof_ref))
+    revalidated=dict(actual_reader=context.reader_ref,transport_equivalence=proof)
+    if mathematical!=context.cache_reader_ref or revalidated!=expected:
+        raise ValueError('COMPLETED_SOURCE_ORIGINAL_PROOF_CONFLICT')
+    context.unchanged()
+    context.identity={**context.identity,'reader_provenance':revalidated}
+    context.reader_transport_provenance=proof
+    return dict(status='REVALIDATED_ORIGINAL_COMPLETED_TRANSPORT_PROOF',numeric_manifest=manifest_ref,
+        original_proof=proof_ref,mathematical_reader=mathematical,core_identity_unchanged=True)
