+def daily_history_coverage(context,root):
+    """Read retained daily coverage; never start the explicit history adapter.
+
+    The numeric owner has already appended today's label and updated available
+    event returns. Missing old labels require the existing explicit bootstrap
+    contract, not an automatic full-history job on every daily completion.
+    """
+    index=load(reference(Path(root)/'index.json'));day=str(context.target)
+    manifest_ref=index['dates'][day];manifest=load(manifest_ref);product=load(manifest['artifact'])
+    if (product.get('data_date')!=day or manifest.get('data_date')!=day
+        or product.get('source_identity')!=context.identity
+        or product.get('source_generation')!=context.generation
+        or product.get('source_config')!=context.config_ref
+        or any(product.get(k)!=v for k,v in FLAGS.items())):
+        raise ValueError('DAILY_HISTORY_COVERAGE_SOURCE_CONFLICT')
+    selected=sorted(row['symbol']for row in product['rows'])
+    if len(selected)!=len(set(selected)):raise ValueError('DAILY_HISTORY_COVERAGE_DUPLICATE')
+    incomplete=[];missing_dates=0
+    for symbol in selected:
+        row=load(product['row_refs'][symbol]);coverage=row.get('historical_coverage')or{}
+        if (row.get('symbol')!=symbol or row.get('data_date')!=day
+            or any(row.get(k)!=v for k,v in FLAGS.items())):
+            raise ValueError('DAILY_HISTORY_COVERAGE_ROW_CONFLICT:'+symbol)
+        available,evaluated=coverage.get('available_prefix_dates'),coverage.get('evaluated_count')
+        if (type(available)is not int or type(evaluated)is not int
+            or not 0<=evaluated<=available):
+            raise ValueError('DAILY_HISTORY_COVERAGE_COUNTS_INVALID:'+symbol)
+        if not coverage.get('known_full_history')or coverage.get('missing'):
+            gap=available-evaluated;missing_dates+=gap
+            incomplete.append(dict(symbol=symbol,available_prefix_dates=available,
+                evaluated_count=evaluated,missing_label_date_count=gap,
+                missing=coverage.get('missing',[]),row=product['row_refs'][symbol]))
+    context.unchanged()
+    return dict(status='PARTIAL_NEEDS_EXPLICIT_BOOTSTRAP'if incomplete else'COMPLETE_NO_HISTORY_GAPS',
+        numeric_manifest=manifest_ref,source_generation=context.generation,candidate_count=len(selected),
+        complete_stocks=len(selected)-len(incomplete),incomplete_stocks=len(incomplete),
+        missing_label_date_count=missing_dates,incomplete=incomplete,
+        history_bootstrap_in_daily_path=False,new_label_evaluations=0,new_return_evaluations=0,
+        daily_update_owner='materialize_daily_product.cached_daily_statistics',
+        required_action='EXPLICIT_EXISTING_BOOTSTRAP_CONTRACT_ONLY'if incomplete else None,**FLAGS)
+
