+            descriptors.append(_source_descriptor(path, raw, _sha(raw), [], identity="AUCTION_AUTHORITY_TRIO",
+                cutoff="09:19:59", semantics="READ_ONLY_CONFIGURED_SOURCE_TRIO"))
