+    path = directory / "attestation.json"; attestation = json.loads(path.read_bytes())
+    assert _sha(Path(verifier.__file__).read_bytes()) == "32872ffd4f99ca774252d238d38033c39b3dd0ab9b449a69c2dd35fddc556fc5"
