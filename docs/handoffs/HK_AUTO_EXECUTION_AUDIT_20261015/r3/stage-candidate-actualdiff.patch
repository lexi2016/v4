+def test_d1_import_lock_transient_wait_revalidates_without_writes(tmp_path, monkeypatch):
+    import os, fcntl
+    from ops import verify_stage_execution as v
+    fixture = _fixture(tmp_path); marker = fixture["hk_d1_root"] / ".import.lock"
+    marker.write_text("test-reader-owner")
+    # A separate test actor releases its own synthetic marker. The verifier
+    # process has every mutation/lock/process call blocked while validating.
+    child = subprocess.Popen([sys.executable, "-B", "-c",
+        "import time,pathlib;time.sleep(.15);pathlib.Path(__import__('sys').argv[1]).unlink()", str(marker)])
+    calls = []
+    def refuse(*args, **kwargs):
+        calls.append("mutation_or_lock"); raise AssertionError("verifier attempted a mutation")
+    try:
+        with monkeypatch.context() as guard:
+            for obj, names in ((os, ("mkdir", "makedirs", "unlink", "remove", "replace", "rename", "write")),
+                               (Path, ("write_bytes", "write_text", "mkdir", "unlink", "touch")),
+                               (fcntl, ("flock", "lockf")), (subprocess, ("Popen", "run"))):
+                for name in names: guard.setattr(obj, name, refuse)
+            result = v._d1_pool_time_binding(*_d1_retry_inputs(fixture))
+        assert result["status"] == "CONFIGURED_EXACT_DATE_TOP100_TRIO_VERIFIED"
+        assert calls == []
+    finally: child.wait(timeout=5)
+
