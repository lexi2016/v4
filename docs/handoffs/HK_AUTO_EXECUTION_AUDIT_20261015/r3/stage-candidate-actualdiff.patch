+            if _d1_read_anchor(d1_root, trade_date, preselection_source_root) != anchor:
+                raise VerificationError("CURRENT_HK_D1_CHANGED_DURING_IMPORT_WAIT")
+            _refuse_d1_pending(roots, trade_date)
