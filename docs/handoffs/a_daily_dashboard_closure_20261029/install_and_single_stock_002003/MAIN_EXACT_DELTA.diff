+   fk=strict_and(cmp(None if pct is None else (pct-1)*100,'>=',N(4)),cmp(r['c'],'>=',r['o']) if valid(r) else None,strict_or(cmp(volr,'>=',N('1.45')),cmp(vm,'>=',N('1.35')),pl1),cmp(cp,'>=',N('.45')))
