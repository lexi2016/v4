+def _load_identity(root: Path | str | None, day: str, symbol: Mapping[str, Any], *,
+                   loader_cache: dict[str, Any] | None = None) -> dict[str, Any]:
+    """Use exact-date verified V4 registries. Names are never supplied by callers."""
