+INDEX_ROOT = 'external_sources/zsxq_hourly/pdf_search_derived_v1'
+SCHEMA = 'v4.zsxq_pdf_search_day.v1'
+BIT_COUNT = 16384
+BIT_BYTES = BIT_COUNT // 8
+MAX_DAY_BYTES = 16 * 1024 * 1024
+MAX_BATCH_DOCUMENTS = 10
