+        projected.append({
+            "label": label,
+            "group": proxy.get("group"),
+            "mapping_type": proxy.get("mapping_type"),
+            "proxy_symbols": list(proxy.get("proxy_symbols") or []),
+            "metric_kind": "OFFICIAL_BOARD",
+            "available_symbols": [],
+            "missing_symbols": [],
+            "requested_symbol_count": 0,
+            "available_symbol_count": 0,
