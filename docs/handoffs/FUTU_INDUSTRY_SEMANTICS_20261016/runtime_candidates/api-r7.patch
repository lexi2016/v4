+                "status": "CANNOT_CONFIRM",
+                "cannot_confirm": ["FUTU_BOARD_SNAPSHOT_MISSING"],
+            }
+        official_ready = (
+            board.get("status") == "READY"
+            and board.get("plate_valid") is True
