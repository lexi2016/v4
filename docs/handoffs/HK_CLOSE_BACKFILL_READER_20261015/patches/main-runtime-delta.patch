+def _append_reason(payload: dict[str, Any], reason: str) -> dict[str, Any]:
+    reasons = list(payload.get("cannot_confirm") or [])
+    if reason not in reasons:
+        reasons.append(reason)
+    payload["cannot_confirm"] = reasons
+    return payload
+
