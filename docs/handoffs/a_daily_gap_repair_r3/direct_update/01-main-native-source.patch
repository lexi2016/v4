+        raise ValueError('G4DAY_CACHE_LAYOUT_INVALID')
+    history = []
+    previous = int(value['previous_session'])
+    for _ in range(MAX_CACHED_HISTORY_INPUTS):
+        cached = path.parent.parent / str(previous) / 'input.json'
+        if not cached.exists():
