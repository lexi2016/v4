+def selected_history_retention(current: dict | None, *, target: int) -> dict | None:
+    """Explicit D10 metadata-only admission of the independently reviewed stock."""
+    import struct
+    names = ("V4_QFQ_RETENTION_BASELINE_PATH", "V4_QFQ_RETENTION_BASELINE_SHA256",
+             "V4_QFQ_RETENTION_SUCCESSOR_PATH", "V4_QFQ_RETENTION_SUCCESSOR_SHA256")
+    supplied = [os.environ.get(name) for name in names]
+    if not any(supplied):
+        return current
+    if not all(supplied):
+        raise QfqGateError("RETENTION_SUCCESSOR_EXPLICIT_D10_BINDINGS_REQUIRED")
+    refs = [dict(path=supplied[i], sha256=supplied[i+1]) for i in (0, 2)]
+    baseline, successor = [json.loads(_source(ref, owner="retention selection").read_text()) for ref in refs]
+    keys = {"source_config", "source_policy", "archive_refs", "accepted_evidence"}
+    if (set(baseline) != keys or set(successor) != keys or current not in (baseline, successor)
+            or any(successor[key] != baseline[key] for key in ("source_policy", "archive_refs"))
+            or successor["accepted_evidence"][:len(baseline["accepted_evidence"])] != baseline["accepted_evidence"]):
+        raise QfqGateError("RETENTION_SUCCESSOR_BASELINE_OR_EVIDENCE_CHANGED")
+    if target < 20261110 or (current == baseline and target != 20261110):
+        raise QfqGateError("RETENTION_SUCCESSOR_INITIAL_ADMISSION_REQUIRES_D10")
+    before, after = [json.loads(_source(value["source_config"], owner="retention source config").read_text())
+                     for value in (baseline, successor)]
+    if (len(before["stocks"]) != 5541 or len(after["stocks"]) != 5542
+            or after["stocks"][:-1] != before["stocks"]
+            or {k:v for k,v in before.items() if k != "stocks"} != {k:v for k,v in after.items() if k != "stocks"}):
+        raise QfqGateError("RETENTION_SUCCESSOR_ORIGINAL_MEMBERS_CHANGED")
+    stock = after["stocks"][-1]
+    if (stock.get("code") != "301314.SZ" or any(row.get("code") == "301314.SZ" for row in before["stocks"])
+            or len(stock.get("sources", [])) != 1):
+        raise QfqGateError("RETENTION_SUCCESSOR_NEW_MEMBER_SCOPE")
+    extra = successor["accepted_evidence"][len(baseline["accepted_evidence"]):]
+    evidence = [(ref, json.loads(_source(ref, owner="added stock evidence").read_text())) for ref in extra]
+    facts = [(ref, value) for ref, value in evidence
+             if value.get("schema") == "V4_EXACT_301314_20261110_TYPED_SOURCE_FACT_V1"]
+    if len(facts) != 1:
+        raise QfqGateError("RETENTION_SUCCESSOR_TYPED_FACT_REQUIRED")
+    fact_ref, fact = facts[0]
+    if (fact.get("symbol") != "301314.SZ" or fact.get("target_date") != 20261110
+            or fact.get("resolved_rows") != 868 or len(fact.get("events", [])) != 4
+            or not any(value.get("verdict") == "REVIEWED/PASS" and value.get("reviewer")
+                       and value.get("source_fact_sha256") == fact_ref["sha256"] for _, value in evidence)):
+        raise QfqGateError("RETENTION_SUCCESSOR_INDEPENDENT_FACT_REVIEW_REQUIRED")
+    source = stock["sources"][0]
+    if source.get("name") != "native" or source.get("kind") != "day_bytes":
+        raise QfqGateError("RETENTION_SUCCESSOR_WHOLE_NATIVE_REQUIRED")
